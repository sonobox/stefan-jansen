<wgcompilation>
  <title>Le Tour De France</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2003.5</number>

  <content>
    <cd name = "Bernard Hinault">
      <track><artist>Plastic Bertrand</artist>
             <title>Ça Plane Pour Moi</title>
             <quote>allez hop! la nana quel panard! quelle vibration</quote>
             <year>1977</year>
             <country>BE</country>
      </track>
      <track><artist>Les Rita Mitsouko</artist>
             <title>Marcia Baïla</title>
             <quote>c'est la mort, tu t'es consumée marcia</quote>
             <year>1984</year>
             <country>FR</country>
      </track>
      <track><artist>Taxi-Girl</artist>
             <title>Chercher Le Garçon</title>
             <quote>cherchez le garçon, trouvez son nom</quote>
             <year>1980</year>
             <country>FR</country>
      </track>
      <track><artist>Rose Laurens</artist>
             <title>Africa (Extended French Version)</title>
             <quote>un sorcier vaudou m'a peint la visage</quote>
             <year>1982</year>
             <country>FR</country>
      </track>
      <track><artist>Vanessa Paradis</artist>
             <title>Joe Le Taxi</title>
             <quote>la musique à joe c'est la rumba le vieux rock au mambo</quote>
             <year>1987</year>
             <country>FR</country>
      </track>
      <track><artist>France Gall</artist>
             <title>Ella, Elle L'A</title>
             <quote>cette petite flamme tape sur des tonneaux</quote>
             <year>1987</year>
             <country>FR</country>
      </track>
        <track><artist>Desireless</artist>
             <title>Voyage, Voyage (12" Italo Disco Mix)</title>
             <quote>sur le dunes du sahara deiles fidji au fujiyama</quote>
             <year>1986</year>
             <country>FR</country>
      </track>
      <track><artist>Jean-Jacques Goldman</artist>
             <title>Envole-Moi</title>
             <quote>remplis ma tête d'autres horizons, d'autres mots</quote>
             <year>1984</year>
             <country>FR</country>
      </track>
      <track><artist>Jakie Quartz</artist>
             <title>Vivre Ailleurs</title>
             <quote>je voudrais vivre ailleurs</quote>
             <year>1986</year>
             <country>FR</country>
      </track>
      <track><artist>Axel Bauer</artist>
             <title>Cargo</title>
             <quote>l'alcool est mon allié l'amour, il faut payer (cargo d'ennui)</quote>
             <year>1983</year>
             <country>FR</country>
      </track>
      <track><artist>Jean-Pierre Mader</artist>
             <title>Macumba</title>
             <quote>les verres de tequila réchauffent sa mémoire</quote>
             <year>1985</year>
             <country>FR</country>
      </track>
      <track><artist>Guesch Patti</artist>
             <title>Etienne (Version Longue)</title>
             <quote>baiser salé, sali tombé le long du lit</quote>
             <year>1987</year>
             <country>FR</country>
      </track>
      <track><artist>Richard Gotainer</artist>
             <title>Le Mambo Du Délcalco</title>
      	     <quote>et du pouce on coulisse et un davy crockett</quote>
             <year>1982</year>
             <country>FR</country>
      </track>      
      <track><artist>Debut De Soirée</artist>
             <title>Nuit De Folie</title>
             <quote>tu danses le monde musique américaine</quote>
             <year>1988</year>
             <country>FR</country>
      </track>
      <track><artist>Elsa</artist>
             <title>T'en Va Pas</title>
             <quote>qu'elle est la femme de ta vie vie vie</quote>
             <year>1986</year>
             <country>FR</country>
      </track>
      <track><artist>Jeanne Mas</artist>
             <title>En Rouge Et Noir</title>
             <quote>dans les noir des grandes forêts, je me suis souvent perdue</quote>
             <year>1986</year>
             <country>FR</country>
      </track>
      <track><artist>Caroline Loeb</artist>
             <title>C'est La Ouate</title>
             <quote>de toutes les matieres c'est la ouate qu'elle prefere</quote>
             <year>1986</year>
             <country>FR</country>
      </track>
      <track><artist>Mylène Farmer</artist>
             <title>Libertine</title>
             <quote>la vie est triste comme un verre de grenadine</quote>
             <year>1986</year>
             <country>FR</country>
      </track>
      </cd>
      
      <cd name="Jan Ullrich">      
      <track><artist>Anouk</artist>
             <title>L'Étoile Polaire</title>
             <quote>après la vie il y'a la mort</quote>
             <year>1997</year>
             <country>FR</country>
      </track>
      <track><artist>Thomas Fersen</artist>
             <title>Le Chat Botté</title>
             <quote>c'est mon destin je suppose</quote>
             <year>2003</year>
             <country>FR</country>
      </track>
      <track><artist>-M-</artist>
             <title>Nostalgic Du Cool</title>
             <quote>automat traumatisé</quote>
             <year>1997</year>
             <country>FR</country>
      </track>
      <track><artist>Dominique A</artist>
             <title>Le Courage Des Oiseaux</title>
             <quote>si seulement nous avions le courage des oiseaux qui chantent dans le vent glace</quote>
             <year>1992</year>
             <country>FR</country>
      </track>
      <track><artist>Toog</artist>
             <title>X'tern</title>
             <quote>je vais te dire une chose: mon intelligence dépend du hasard qui la provoque</quote>
             <year>1999</year>
             <country>FR</country>
      </track>
      <track><artist>Bénabar</artist>
             <title>Y'a Une Fille Qui Habite Chez Moi</title>
             <quote>quelqu'un a massacré tous mes amis cafards</quote>
             <year>2001</year>
             <country>FR</country>
      </track>
      <track><artist>Benjamin Biolay</artist>
             <title>Chaise À Tokyo</title>
             <quote>no manga, no bongo, une chaise à tokyo</quote>
             <year>2003</year>
             <country>FR</country>
      </track>
      <track><artist>Noir Désir</artist>
             <title>Le Vent Nous Portera</title>
             <quote>génétique en bandouillère des chromosomes dans l'athmosphère</quote>
             <year>2001</year>
             <country>FR</country>
      </track>
      <track><artist>Alizée</artist>
             <title>C'est Trop Tard</title>
             <quote>bien trop tard! j'en ai marre</quote>
             <year>2003</year>
             <country>FR</country>
      </track>
      <track><artist>Bertrand Burgalat</artist>
             <title>Aux Cyclades Electronique</title>
             <quote>jens voigt: das ist kein wellness, was wir da machen</quote>
             <year>2000</year>
             <country>FR</country>
      </track>
      <track><artist>Roméo</artist>
             <title>Charlotte</title>
             <quote>il faut faire attention aux bêtes</quote>
             <year>2002</year>
             <country>FR</country>
      </track>
      <track><artist>Mathieu Boogaerts</artist>
             <title>Ondulé</title>
             <quote>i never feel the same</quote>
             <year>1995</year>
             <country>FR</country>
      </track>
      <track><artist>Katerine</artist>
             <title>L'Appartement</title>
             <quote>avec vue sur le sentier</quote>
             <year>1999</year>
             <country>FR</country>
      </track>
      <track><artist>De Palmas</artist>
             <title>Une Seule Vie</title>
             <quote>inquiet, soucieux, honnête jour et nuit</quote>
             <year>2001</year>
             <country>FR</country>
      </track>
      <track><artist>Clarika</artist>
             <title>Beau Comme Garçon</title>
             <quote>love me please, i'm a sorrow boy</quote>
             <year>1996</year>
             <country>FR</country>
      </track>
      <track><artist>Pink Martini</artist>
             <title>Sympathique</title>
             <quote>je ne veux pas travailler, je ne veux pas déjeuner</quote>
             <year>1997</year>
             <country>US</country>
      </track>
      <track><artist>Françoiz Breut</artist>
             <title>Si Tu Disais</title>
             <quote>je me demande pourquoi tu es là</quote>
             <year>2000</year>
             <country>FR</country>
      </track>
      <track><artist>Autour De Lucie</artist>
             <title>Chanson Sans Issue  (Ne Vois-tu Pas)</title>
             <quote>ne vois-tu pas</quote>
             <year>1997</year>
             <country>FR</country>
      </track>
      <track><artist>Mickey 3D</artist>
             <title>Regarde Les Amants</title>
             <quote>regarde les vivants, regarde les superbes</quote>
             <year>2001</year>
             <country>FR</country>
      </track>
      <track><artist>-M-</artist>
             <title>Nostalgic Du Cool (Live)</title>
             <quote>aujourd'hui je savais ma chance, je dois retrouves ton enfance</quote>
             <year>2001</year>
             <country>FR</country>
      </track>
      <track><artist>Carla Bruni</artist>
             <title>Quelqu'un M'a Dit</title>
             <quote>serais ce possible alors</quote>
             <year>2002</year>
             <country>FR</country>      
      </track>
      <track><artist>Kraftwerk</artist>
             <title>Tour De France</title>
             <quote>sprint final à l'arrivée</quote>
             <year>1983</year>
             <country>DE</country>      
      </track>     
