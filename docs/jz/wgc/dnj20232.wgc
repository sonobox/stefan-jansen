<wgcompilation>
  <title>Absolute Giganten</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2023.2</number>
  <content>
    <cd>
      <track>
             <artist>IFA Wartburg</artist>
             <title>FDJ</title>
             <quote>sie erfahren von gebaren, von manier und takt und ton, sozialismus, kommunismus, lenin und revolution</quote>
