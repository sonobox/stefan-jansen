<wgcompilation>

  <title>Révolution - Революция - Revolución</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2007.2</number>

  <content>
   <cd>
    <track><artist>Skalariak</artist>
           <title>Vodka Revolución</title>
           <quote>se sacio la sed de la pobre gente, buscaban su solución</quote>
           <year>2001</year>
           <country>ES</country>    
    </track>
    <track><artist>Spitfire</artist>
           <title>Танцы</title>
           <quote translation = "musik fliesst in unseren venen wie blut">музыка течет в наших венах, словно кровь</quote>
           <year>2003</year>
           <country>RU</country>    
    </track>
    <track><artist>Ляпис Трубецкой</artist>
           <title>Курвы</title>
           <quote translation = "huren tanzen auf dem ball">курвы танчуць баль</quote>
           <year>2004</year>
           <country>BY</country>    
    </track>
    <track><artist>Ленинград</artist>
           <title>WWW</title>
           <quote translation = "meine adresse ist weder ein haus noch eine strasse, meine Adresse lautet heute: www leningrad spb.ru">мой адрес не дом и не улица, мой адрес сегодня такой: www ленинград spb точка ру</quote>
           <year>2002</year>
           <country>RU</country>    
    </track>
    <track><artist>The Busters</artist>
           <title>Mickey Mouse In Moscow (Boost)</title>
           <quote>gimme vodka all the russians sing, abandon any hope</quote>
           <year>1988</year>
           <country>DE</country>    
    </track>
    <track><artist>Banda Bassotti</artist>
           <title>Bella Ciao</title>
           <quote>o partigiano, portami via, ché mi sento di morir</quote>
           <year>1993</year>
           <country>IT</country>    
    </track>
    <track><artist>Mano Negra</artist>
           <title>Peligro</title>
           <quote>cuidao donde sea, que te andan buscando los de la seguridad</quote>
           <year>1989</year>
           <country>FR</country>    
    </track>
    <track><artist>Ska-P</artist>
           <title>Ñapa Es</title>
           <quote>y aquí no pasa nada, nos comemos la tostada, ni siquiera te levantas del sofá</quote>
           <year>1996</year>
           <country>ES</country>    
    </track>
    <track><artist>Fermin Muguruza</artist>
           <title>Urrun</title>
           <quote translation = "todo queda lejos, tras la puerta de mi casa">dena dago urrun, nire etxeko atetik at</quote>
           <year>1999</year>
           <country>ES</country>    
    </track>
    <track><artist>Athena</artist>
           <title>Skalonga (Nihavend Longa)</title>
           <quote>kaç kere kaç ola?</quote>
           <year>1998</year>
           <country>TR</country>    
    </track>
    <track><artist>Don Pepe</artist>
           <title>¿Porque No Puedo Ser Tu?</title>
           <quote>quiero ser como tu</quote>
           <year>1999</year>
           <country>US</country>    
    </track>
    <track><artist>100% Collègues</artist>
           <title>On Est Venu</title>
           <quote>pas de feintes: vous perdez, on vous esquinte</quote>
           <year>2000</year>
           <country>FR</country>    
    </track>
    <track><artist>Les Négresses Vertes</artist>
           <title>La Danse Des Negresses Vertes</title>
           <quote>y'en a marre que les noirs soient noirs et que les blancs encore plus blancs et que les jaunes restent aussi jaunes</quote>
           <year>1989</year>
           <country>FR</country>    
    </track>
    <track><artist>Plexus Solaire</artist>
           <title>Perdu</title>
           <quote>et c'est comme ça que je m'suis retrouvé par terre, les pieds en l'air, la tête de travers, à ne plus rien, rien pouvoir faire</quote>
           <year>2007</year>
           <country>AT</country>    
    </track>
    <track><artist>Mano Solo</artist>
           <title>Allô Paris</title>
           <quote>comme chaque soir je te raconte l'histoire des larmes de rue</quote>
           <year>1993</year>
           <country>FR</country>    
    </track> 
    <track><artist>Manu Chao</artist>
           <title>Rumba De Barcelona</title>
           <quote>te mercé bibi malena, te mercé perro chaval</quote>
           <year>2002</year>
           <country>FR</country>    
    </track>
    <track><artist>Los Del Garrote</artist>
           <title>La Cumbia Del Garrote</title>
           <quote>yo soy un hombre bueno, me va a denunciar</quote>
           <year>1999</year>
           <country>AR</country>    
    </track>
    <track><artist>King Mafrundi</artist>
           <title>Hasta Siempre</title>
