<wgcompilation>
  <title>Mash Hits</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2024.1</number>
  <content>
    <cd>
      <track><artist>Marina &amp; The Diamonds vs. Cold Cave</artist>
             <title>A Little Death To Primadonna (Adriana A)</title>
             <quote>you say that I'm kinda difficult but it's always someone else's fault</quote>
