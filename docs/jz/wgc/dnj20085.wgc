<wgcompilation>
  <title>The Vinyl Frontier</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2008.5</number>

  <content>
    <cd name = "80s House">
      <track><artist>S'Express</artist>
             <title>Theme From S'Express</title>
             <quote>drop that ghetto blaster</quote>
	           <year>1988</year>
	           <country>GB</country>
      </track>
      <track><artist>Bomb The Bass</artist>
             <title>Beat Dis</title>
             <quote>the names have been changed to protect the innocent</quote>
      	     <year>1987</year>
	           <country>GB</country>
      </track>
      <track><artist>M|A|R|R|S</artist>
             <title>Pump Up The Volume</title>
             <quote>put the needle on the record when the drum beats go like this</quote>
	           <year>1987</year>
	           <country>GB</country>
      </track>
      <track><artist>Hithouse</artist>
             <title>Jack To The Sound Of The Underground</title>
             <quote>don't need no one that's no good for me</quote>
	           <year>1987</year>
	           <country>NL</country>
      </track>
      <track><artist>D Mob feat. Gary Haisman</artist>
             <title>We Call It Acieed</title>
             <quote>you turn on, you tune in, you drop out</quote>
	           <year>1988</year>
	           <country>GB</country>
      </track>
      <track><artist>Edelweiss</artist>
             <title>Bring Me Edelweiss</title>
             <quote>the dopest flower from the top of the mountain</quote>
	           <year>1988</year>
	           <country>AT</country>
      </track>
      <track><artist>Mysterious Art</artist>
             <title>Das Omen</title>
             <quote>denn alles, was entsteht, ist wert, dass es zugrunde geht</quote>
	           <year>1989</year>
	           <country>DE</country>
      </track>
      <track><artist>Voyou</artist>
             <title>Houseman</title>
             <quote>germany calling</quote>
	           <year>1987</year>
	           <country>DE</country>
      </track>
      <track><artist>The Invincible Spirit</artist>
             <title>Make A Device</title>
             <quote>special thanks for the current news</quote>
	           <year>1987</year>
	           <country>DE</country>
      </track>
      <track><artist>Liaisons D</artist>
             <title>Heart-Beat</title>
             <quote>new beat is boring, acid house is dead, this is trance dance</quote>
	           <year>1989</year>
	           <country>BE</country>
      </track>
      <track><artist>16 Bit</artist>
             <title>Where Are You (12" Version)</title>
             <quote>the day has come to exercise the devil in you</quote>
	           <year>1986</year>
	           <country>DE</country>
      </track>
      <track><artist>Robotiko Rejekto</artist>
             <title>Umsturz Jetzt!</title>
             <quote>neue tanz</quote>
	           <year>1988</year>
	           <country>DE</country>
      </track>
      <track><artist>Tragic Error</artist>
             <title>Tanzen</title>
             <quote>oh, oh, der bass-drum bass-drum</quote>
      	     <year>1989</year>
	           <country>BE</country>
      </track>
      <track><artist>Off</artist>
             <title>Electrica Salsa</title>
             <quote>the magic words i say to you, now open up your ears: hazam halum gelum daza niaculum lulum saza</quote>
      	     <year>1986</year>
	           <country>DE</country>
      </track>
      <track><artist>Out Of The Ordinary</artist>
             <title>Play It Again</title>
             <quote>spiel es, sam</quote>
	           <year>1989</year>
	           <country>DE</country>
      </track>
      <track><artist>Lil' Louis</artist>
             <title>French Kiss (The Original Underground Mix)</title>
             <quote>locutus: i am locutus of borg. resistance is futile. your life, as it has been is over. from this time forward, you will service us.</quote>
	           <year>1989</year>
	           <country>US</country>
      </track>
    </cd>    

    <cd name = "90s Techno">
      <track><artist>U96</artist>
             <title>Das Boot</title>
             <quote>1 2 3 techno</quote>
	           <year>1991</year>
	           <country>DE</country>
      </track>
      <track><artist>LDC</artist>
             <title>Die Schwarze Zone</title>
             <quote>im jahre 2598 nach christus kam es zur wohl größten interplanetaren kollision zweier planeten</quote>
	           <year>1991</year>
	           <country>DE</country>
      </track>
      <track><artist>Scrot</artist>
             <title>Der Teufelsrhythmus</title>
             <quote>faulzahnig, alt, bucklig, warzennasig und nicht blond, blauäugig</quote>
	           <year>1990</year>
	           <country>DE</country>
      </track>
      <track><artist>U-Tek</artist>
             <title>Das Mass Der Dinge</title>
             <quote>meins, nicht deins, denn meins ist größer als deins</quote>
	           <year>1991</year>
	           <country>DE</country>
      </track>
      <track><artist>The Force Dimension</artist>
             <title>Algorythm (Manipulating Mix)</title>
             <quote>blame on me, blame on you</quote>
	           <year>1990</year>
	           <country>NL</country>
      </track>
      <track><artist>Negrosex</artist>
             <title>Teknó La Drôga (v2.2)</title>
             <quote>el grupo de rock 'n' roll más famoso del mundo</quote>
	           <year>1991</year>
	           <country>DE</country>
      </track>
      <track><artist>Eskimos &amp; Egypt</artist>
             <title>Welcome To The Future</title>
             <quote>this ain't rock'n'roll</quote>
	           <year>1992</year>
	           <country>GB</country>
      </track>
      <track><artist>T99</artist>
             <title>Anasthasia</title>
             <quote>pump it up at the drop of a dime</quote>
	           <year>1991</year>
	           <country>BE</country>
      </track>
      <track><artist>The KLF</artist>
             <title>What Time Is Love? (Live At Trancentral)</title>
             <quote>we had to pass the pyramid blaster</quote>
	           <year>1990</year>
	           <country>GB</country>
      </track>
      <track><artist>The Shamen</artist>
             <title>Move Any Mountain (Progen 91)</title>
             <quote>with delivery smooth like water from a fountain</quote>
	           <year>1991</year>
	           <country>GB</country>
      </track>
      <track><artist>Utah Saints</artist>
             <title>Something Good</title>
             <quote>utah saints, utah saints, utah saints, u-u-u-utah saints</quote>
	           <year>1992</year>
	           <country>GB</country>
      </track>
      <track><artist>Moby</artist>
             <title>Go</title>
             <quote>borg: freedom is irrelevant. self-determination is irrelevant. you must comply.</quote>
	           <year>1991</year>
	           <country>US</country>
      </track>
      <track><artist>Guru Josh</artist>
             <title>Infinity</title>
             <quote>1990s, time for the guru</quote>
	           <year>1990</year>
	           <country>JE</country>
      </track>
      <track><artist>Juno Reactor</artist>
             <title>High Energy Protons (Orion Mix)</title>
             <quote>everything is going extremely well, you are the brain and central nervous system</quote>
	           <year>1994</year>
	           <country>GB</country>
      </track>
      <track><artist>Opus III</artist>
             <title>It's A Fine Day</title>
             <quote>people open windows, they leave their houses, just for a short while</quote>
	           <year>1992</year>
	           <country>GB</country>
      </track>
      <track><artist>The Prodigy</artist>
             <title>Out Of Space</title>
             <quote>i take your brain to another dimension</quote>
	           <year>1994</year>
	           <country>GB</country>
      </track>
      <track><artist>WestBam</artist>
             <title>Celebration Generation (Maximal)</title>
             <quote>guinan: when a man is convinced he's going to die tomorrow, he'll probably find a way to make it happen.</quote>
	           <year>1993</year>
	           <country>DE</country>
      </track>
    </cd>
  </content>

