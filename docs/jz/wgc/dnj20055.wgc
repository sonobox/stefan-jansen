<wgcompilation>
  <title>Sex Und Abstinenz In Den Neunzigern</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2005.5</number>

  <content>
    <cd name = "Sex in den Neunzigern">
      <track><artist>!Bang Elektronika</artist>
             <title>Aktivierung!</title>
             <quote>elektronisches sprechverbot, gefühlsverbot, kein verstand</quote>
             <year>1994</year>
             <country>CA</country>
      </track>
      <track><artist>S.P.O.C.K</artist>
             <title>Never Trust A Klingon</title>
             <quote>if you ever would give them a helping hand you can be sure they'll chop off the arm</quote>
             <year>1993</year>
             <country>SE</country>
      </track>
      <track><artist>Tilt!</artist>
             <title>Merciless</title>
             <quote>inquisition japanese, hang man</quote>
             <year>1990</year>
             <country>DE</country>
      </track>
      <track><artist>Calva Y Nada</artist>
             <title>Aufprall</title>
             <quote>die welt ist schlecht und durchgezecht</quote>
             <year>1995</year>
             <country>DE</country>
      </track>
      <track><artist>Apoptygma Berzerk</artist>
             <title>Non-Stop Violence</title>
             <quote>come, go, step inside, bring me news from the dying world</quote>
             <year>1995</year>
             <country>NO</country>
      </track>
      <track><artist>Noise Unit</artist>
             <title>Other World</title>
             <quote>i saw the devil tonight</quote>
             <year>1996</year>
             <country>CA</country>
      </track>
      <track><artist>X-Marks The Pedwalk</artist>
             <title>Facer</title>
             <quote>your voice is just a whispering</quote>
             <year>1995</year>
             <country>DE</country>
      </track>
      <track><artist>Steril</artist>
             <title>Virus Perform</title>
             <quote>you against the nature</quote>
             <year>1993</year>
             <country>DE</country>
      </track>
      <track><artist>KMFDM</artist>
             <title>Ultra</title>
             <quote>but i don't need you anymore, you cannot hurt me anymore</quote>
             <year>1995</year>
             <country>DE</country>
      </track>
      <track><artist>:wumpscut:</artist>
             <title>In The Night (Remastered)</title>
             <quote>forbidden fruit has always been for only the tough</quote>
             <year>1995</year>
             <country>DE</country>
      </track>
      <track><artist>Leæther Strip</artist>
             <title>Don't Tame Your Soul</title>
             <quote>there is no life worth living when you can't explore the mind</quote>
             <year>1993</year>
             <country>DK</country>
      </track>
      <track><artist>Suicide Commando</artist>
             <title>Revenge</title>
             <quote>ashes to ashes, dust to dust, reincarnation, in god we trust</quote>
             <year>1994</year>
             <country>BE</country>
      </track>
      <track><artist>Front Line Assembly</artist>
             <title>Neologic Spasm</title>
             <quote>dying sensation, fascination, expectation, recreation</quote>
             <year>1995</year>
             <country>CA</country>
      </track>
      <track><artist>Haujobb</artist>
             <title>World Window</title>
             <quote>more execution on demand displayed in detail</quote>
             <year>1995</year>
             <country>DE</country>
      </track>
      <track><artist>Clock DVA</artist>
             <title>Final Program</title>
             <quote>watch my program</quote>
             <year>1991</year>
             <country>GB</country>
      </track>
      <track><artist>Dementia</artist>
             <title>Ice Age</title>
             <quote>can you ever feel what i feel for you</quote>
             <year>1996</year>
             <country>DE</country>
      </track>

    </cd>    
    <cd name = "Abstinenz in den Neunzigern">
      <track><artist>Project Pitchfork</artist>
             <title>Souls</title>
             <quote>lass die erinnerung erwachen</quote>
             <year>1992</year>
             <country>DE</country>
      </track>
      <track><artist>Die Form</artist>
             <title>Silent Order</title>
             <quote>1959, 1959</quote>
             <year>1992</year>
             <country>FR</country>
      </track>
      <track><artist>The Eternal Afflict</artist>
             <title>San Diego (The Tragical)</title>
             <quote>the sun burns into my face</quote>
             <year>1993</year>
             <country>DE</country>
     </track>
      <track><artist>Qntal</artist>
             <title>Ad Mortem Festinamus</title>
             <quote>vita brevis breviter in brevi finietur</quote>
             <year>1992</year>
             <country>DE</country>
      </track>
      <track><artist>Deine Lakaien</artist>
             <title>Love Me To The End (Live)</title>
             <quote>waiting for the dawn, waiting for the night</quote>
             <year>1992</year>
             <country>DE</country>
      </track>
      <track><artist>Engelstaub</artist>
             <title>Victim Of Love</title>
             <quote>love hurts, pain hurts</quote>
             <year>1994</year>
             <country>DE</country>
      </track>
      <track><artist>Artwork</artist>
             <title>Stadt Der Träume</title>
             <quote>trotz kälte ist es warm</quote>
             <year>1993</year>
             <country>DE</country>
      </track>
      <track><artist>Die Form</artist>
             <title>Cantique II</title>
             <quote>culpa urbet cultus meus</quote>
             <year>1994</year>
             <country>FR</country>
      </track>
      <track><artist>Second Decay</artist>
             <title>I Hate Berlin</title>
             <quote>hauptstadtfrage ungeklärt und grössenwahn der nicht stagniert</quote>
             <year>1994</year>
             <country>DE</country>
      </track>
      <track><artist>Syntec</artist>
             <title>The Blind Love The Blind</title>
             <quote>the poor love the poor but nothing to eat</quote>
             <year>1993</year>
             <country>DE</country>
      </track>
      <track><artist>S.P.O.C.K</artist>
             <title>Neutral Zone</title>
             <quote>being here is an act of war, we better get out before</quote>
             <year>1993</year>
             <country>SE</country>
      </track>
      <track><artist>ECO</artist>
             <title>Schmutz</title>
             <quote>ich will dich nicht, ich will dich nicht, ich will dich nicht mehr hier</quote>
             <year>1995</year>
             <country>DE</country>
      </track>
      <track><artist>The Breath Of Life</artist>
             <title>Impromptu</title>
             <quote>without thinking</quote>
             <year>1995</year>
             <country>BE</country>
      </track>
      <track><artist>Die Krupps</artist>
             <title>Alive</title>
             <quote>in my world i'm alive and i can't see danger anymore</quote>
             <year>1995</year>
             <country>DE</country>
      </track>
      <track><artist>Dronning Maud Land</artist>
             <title>With Bated Breath</title>
             <quote>my whole life is piercing my mind</quote>
             <year>1994</year>
             <country>DE</country>
      </track>
