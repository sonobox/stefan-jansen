<wgcompilation>
  <title>Up All Night</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2025.2</number>
  <content>
    <cd>
      <track><artist>Gloria Jones</artist>
             <title>Tainted Love</title>
             <quote>and who think love is to play, well, I'm sorry I don't play that way</quote>
             <year>1965</year>
             <country>US</country>
      </track>
      <track><artist>The Flirtations</artist>
             <title>Nothing But A Heartache</title>
             <quote>I got a lot of those heartaches, I got a lot of those tear drops</quote>
             <year>1968</year>
             <country>US</country>
      </track>
      <track><artist>Shirley Ellis</artist>
             <title>Soul Time</title>
             <quote>two, four, six, eight, ooh, I'm synchronized with you</quote>
             <year>1966</year>
             <country>US</country>
      </track>
      <track><artist>Al Wilson</artist>
             <title>The Snake</title>
             <quote>instead of saying thanks, that snake gave her a vicious bite</quote>
             <year>1968</year>
             <country>US</country>
      </track>
      <track><artist>Frank Wilson</artist>
             <title>Do I Love You (Indeed I Do)</title>
             <quote>here I am on bended knees, I lay my heart down at your feet</quote>
             <year>1965</year>
             <country>US</country>
      </track>
      <track><artist>Dobie Gray</artist>
             <title>Out On The Floor</title>
             <quote>I'm really on tonight and everything swingin'</quote>
             <year>1966</year>
             <country>US</country>
      </track>
      <track><artist>Chuck Wood</artist>
             <title>Seven Days Too Long</title>
             <quote>we have a lot of quarrels, yes we have, like all lovers do</quote>
             <year>1967</year>
             <country>US</country>
      </track>
      <track><artist>Tony Clarke</artist>
             <title>Landslide</title>
             <quote>happiness quit me and hurt just hit me</quote>
             <year>1966</year>
             <country>US</country>
      </track>
      <track><artist>R. Dean Taylor</artist>
             <title>There's A Ghost In My House</title>
             <quote>still so deep in the heart of me</quote>
             <year>1967</year>
             <country>CA</country>
      </track>
      <track><artist>Just Brothers</artist>
             <title>Sliced Tomatoes</title>
             <quote>Ian Levine: We found our own records in defiance of the market, in defiance of Radio 1, in defiance of the newspapers, in defiance of the media, and in great defiance of Top of the Pops!</quote>
             <year>1965</year>
             <country>US</country>
      </track>
      <track><artist>The Exciters</artist>
             <title>Blowing Up My Mind!</title>
             <quote>dynamite and nitroglycerin is like a firecracker compared to you</quote>
             <year>1969</year>
             <country>US</country>
      </track>
      <track><artist>The Vel-Vets</artist>
             <title>I Got To Find Me Somebody</title>
             <quote>I'm packin' up, gonna lose that, yeah</quote>
             <year>1967</year>
             <country>US</country>
      </track>
      <track><artist>Reparata &amp; The Delrons</artist>
             <title>Panic</title>
             <quote>I can't get my mind to groove</quote>
             <year>1968</year>
             <country>US</country>
      </track>
      <track><artist>Fontella Bass</artist>
             <title>Rescue Me</title>
             <quote>Can't you see that I'm lonely?</quote>
             <year>1965</year>
             <country>US</country>
      </track>
      <track><artist>Sandi Sheldon</artist>
             <title>You're Gonna Make Me Love You</title>
             <quote>I've been running scared and it's you I've been a'running from</quote>
             <year>1967</year>
             <country>US</country>
      </track>
      <track><artist>The Supremes</artist>
             <title>Love Is Like An Itching In My Heart</title>
             <quote>and, baby, I can't scratch it</quote>
             <year>1966</year>
             <country>US</country>
      </track>
      <track><artist>Marvin Gaye</artist>
             <title>This Love Starved Heart Of Mine (It's Killing Me)</title>
             <quote>life's a nightmare and I can't stand it since you turned me loose</quote>
             <year>1967</year>
             <country>US</country>
      </track>
      <track><artist>Edwin Starr</artist>
             <title>Stop Her On Sight (S.O.S.)</title>
             <quote>I guarantee you it will drive you wild</quote>
             <year>1966</year>
             <country>US</country>
      </track>
      <track><artist>Duke Browner</artist>
             <title>Crying Over You</title>
             <quote>it would tear me apart, when you are gone</quote>
             <year>1966</year>
             <country>US</country>
      </track>
      <track><artist>Roy Hamilton</artist>
             <title>Crackin' Up Over You</title>
             <quote>just another fool, aching in heart, shaking inside, tearing apart</quote>
             <year>1966</year>
             <country>US</country>
      </track>
      <track><artist>Lenny Gamble</artist>
             <title>I'll Do Anything</title>
             <quote>she'd go to the end of the world just to be near me</quote>
             <year>1969</year>
             <country>GB</country>
      </track>
      <track><artist>The Playthings</artist>
             <title>Stop What You're Doing</title>
             <quote>I like it but it's no good for me</quote>
             <year>1973</year>
             <country>GB</country>
      </track>
      <track><artist>Pointer Sisters</artist>
             <title>Send Him Back</title>
             <quote>it's a world of darkness</quote>
             <year>1972</year>
             <country>US</country>
      </track>
      <track><artist>The Carstairs</artist>
             <title>It Really Hurts Me Girl</title>
             <quote>that last bit of my heart puts back together what I've torn apart</quote>
             <year>1973</year>
             <country>US</country>
      </track>
      <track><artist>The M.V.P.'s</artist>
             <title>Turnin' My Heartbeat Up</title>
             <quote>listen to the crash of those cymbals</quote>
             <year>1971</year>
             <country>US</country>
      </track>
      <track><artist>Frankie Valli &amp; The Four Seasons</artist>
             <title>The Night</title>
             <quote>you're gonna lose more than you found</quote>
             <year>1972</year>
             <country>US</country>
      </track>
      <track><artist>Judy Street</artist>
             <title>What</title>
             <quote>Why do you treat me mean and cruel, breaking every rule, can't I be your fool?</quote>
             <year>1968</year>
             <country>US</country>
      </track>
      <track><artist>Jimmy Radcliffe</artist>
             <title>Long After Tonight Is All Over</title>
             <quote>now that I've kissed you I'm craving to kiss you more</quote>
             <year>1965</year>
             <country>US</country>
      </track>
      <track><artist>Tobi Legend</artist>
             <title>Time Will Pass You By</title>
             <quote>life is just a precious minute</quote>
             <year>1968</year>
             <country>US</country>
      </track>
      <track><artist>Dean Parrish</artist>
             <title>I'm On My Way</title>
             <quote>gonna cry, what a way to die</quote>
             <year>1967</year>
             <country>US</country>
      </track>
   </cd>  
  </content>

