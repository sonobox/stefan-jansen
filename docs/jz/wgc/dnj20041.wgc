<wgcompilation>

  <title>Blast Off!</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2004.1</number>

  <content>
   <cd>
    <track><artist>Venus In Furs</artist>
           <title>When I Acquire You</title>
