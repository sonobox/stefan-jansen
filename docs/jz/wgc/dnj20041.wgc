           <year>1983</year>
           <country>IT</country>
    </track>
    <track><artist>Martin Dupont</artist>
           <title>I Met The Beast</title>
           <quote>see, there's a logic they don't need</quote>
           <year>1985</year>
           <country>FR</country>
    </track>
    <track><artist>Gleitzeit</artist>
           <title>Ich Komme Aus Der DDR</title>
