           <country>GB</country>
    </track>
    <track><artist>Neon</artist>
           <title>Dark Age</title>
           <quote>day after day you're away</quote>
           <year>1984</year>
           <country>IT</country>
    </track>
    <track><artist>Class Action</artist>
           <title>Blast Off</title>
           <quote>all i want to do is... blast off!</quote>
           <year>1984</year>
           <country>US</country>
    </track>
    <track><artist>Charles De Goal</artist>
           <title>Un Jeu D'Enfant</title>
