           <year>1982</year>
           <country>ES</country>
    </track>
    <track><artist>Das Kabinette</artist>
           <title>The Cabinet</title>
           <quote>how long should i live</quote>
           <year>1983</year>
           <country>GB</country>
    </track>
    <track><artist>Sexy Angels</artist>
           <title>Mathematic Mind</title>
