<wgcompilation>
  <title>Dekade Zwei</title>
  <season>Jansen / Zeileis</season>
  <number>5</number>

  <content>
   <cd name = "Jansen spielt Zeileis">
   <track><artist>Numero Uno</artist>
           <title>Tora Tora Tora</title>
           <quote>we stayed together for a night, she disappeared out of sight</quote>
           <year>1984</year>
   </track>
   <track><artist>Tobias Bernstrup</artist>
           <title>27 (Laser Mix)</title>
           <quote>i want one maybe more boys taking me out really hard</quote>
           <year>2002</year>
   </track>
   <track><artist>Klein &amp; M.B.O.</artist>
           <title>Dirty Talk</title>
           <quote>visions of the love we knew, i wonder if this talk will do</quote>
           <year>1982</year>
   </track>
   <track><artist>She Wants Revenge</artist>
           <title>Animal Attraction</title>
           <quote>she said dim the lights if you want some action</quote>
           <year>2009</year>
   </track>
   <track><artist>She Past Away</artist>
           <title>Kasvetli Kutlama</title>
           <quote>tüm renkler soldu kapkara çukurda</quote>
           <year>2010</year>
   </track>
   <track><artist>Selofan</artist>
           <title>Shadowmen</title>
           <quote>my lipstick melts, i die for you</quote>
           <year>2017</year>
   </track>
   <track><artist>Dementia</artist>
           <title>Ice Age</title>
           <quote>can you ever feel? can you ever trust?</quote>
           <year>1996</year>
   </track>
   <track><artist>Gang Of Four</artist>
           <title>Damaged Goods</title>
           <quote>heated couplings in the sun, colder couplings in the night</quote>
           <year>1978</year>
   </track>
   <track><artist>King Rocko Schamoni</artist>
           <title>Der Tiger In Der Nacht</title>
           <quote>dann kriegt der sowas auf die fresse vom tiger in der nacht</quote>
           <year>1988</year>
   </track>
   <track><artist>Hotel Morphila Orchester</artist>
           <title>Sex In Der Stadt</title>
           <quote>orgienverstärker</quote>
           <year>1979</year>
   </track>
   <track><artist>Didi &amp; Die Herzschrittmacher</artist>
           <title>Modern</title>
           <quote>moderne haare trägst du modern</quote>
           <year>1982</year>
   </track>
   <track><artist>Andi Arroganti</artist>
           <title>Benzin In Berlin</title>
           <quote>der geruch ist so toll und ich sauge mich voll</quote>
           <year>1982</year>
   </track>
   <track><artist>Agentss</artist>
           <title>Cidade Industrial</title>
           <quote>vejo plakas e automóveis</quote>
           <year>1983</year>
   </track>
   <track><artist>Die Synthetische Republik</artist>
           <title>Der Böse Osten</title>
           <quote>verteidigt unser westliches system, mit einem erstschlag geht das sehr bequem</quote>
           <year>1984</year>
   </track>
   <track><artist>Björn Peng</artist>
           <title>Discoziative Identitätsstörung</title>
           <quote>keinen frieden</quote>
           <year>2014</year>
   </track>
   <track><artist>RockRainer &amp; Typ:t.u.r.b.o.</artist>
           <title>Völlig Überschätzt</title>
           <quote>90er rockballaden sind völlig überschätzt</quote>
           <year>2011</year>
   </track>
   <track><artist>Rainer Von Vielen</artist>
           <title>Empört Euch!</title>
           <quote>nimm dein wort als geschoss, lass es auf die dummen los</quote>
           <year>2014</year>
   </track>
   <track><artist>Kommando Elefant feat. Georgij Makazaria</artist>
           <title>Party Bis Zum Untergang</title>
           <quote>party party party kotzen ins klavier</quote>
           <year>2010</year>
   </track>
   <track><artist>Stéphanie</artist>
           <title>Ouragan</title>
           <quote>une bataille sans trêve, cette nuit à rome</quote>
           <year>1986</year>
   </track>
   </cd>  

   <cd name = "Zeileis spielt Jansen">
    <track><artist>Max &amp; Intro</artist>
           <title>Loš Je Dan</title>
           <quote>sumorna noć gleda dan</quote>
           <year>1984</year>
   </track>
   <track><artist>Partenaire Particulier</artist>
           <title>Partenaire Particulier</title>
           <quote>je suis un être à la recherche, non pas de la vérité mais simplement d'une aventure qui sorte un peu de la banalité</quote>
           <year>1986</year>
   </track>
   <track><artist>Axodry</artist>
           <title>Surrender</title>
           <quote>lies, pleasure, emotions</quote>
           <year>1984</year>
   </track>
   <track><artist>Missing Persons</artist>
           <title>Walking In L.A.</title>
           <quote>one thing's for sure, he isn't starring in the movies</quote>
           <year>1982</year>
   </track>
   <track><artist>Duel</artist>
           <title>Hey, Tu Ne Me Manqueras Plus</title>
           <quote>un shoot de lumière éclairera les pavés</quote>
           <year>2015</year>
   </track>
   <track><artist>Marc Lavoine feat. Bambou</artist>
           <title>Dis-Moi Que L'Amour</title>
           <quote>l'amour ne s'arrête pas</quote>
           <year>2003</year>
   </track>
   <track><artist>Sonnenbrandt</artist>
           <title>Rotes Telefon</title>
           <quote>es ist still seit jahren schon</quote>
           <year>2008</year>
   </track>
   <track><artist>Nathan Jay</artist>
           <title>The Pet Shop Boys Blocked Me On Twitter</title>
           <quote>what have i done to deserve this?</quote>
           <year>2009</year>
   </track>
   <track><artist>Techniques Berlin</artist>
           <title>Love Via Computer</title>
           <quote>custom tailored love to suit all your hopes and dreams</quote>
           <year>1985</year>
   </track>
   <track><artist>R.E.K.</artist>
           <title>Computer Haben Herzschmerz</title>
           <quote>gefühle sind gefroren zwischen dir und mir</quote>
           <year>1983</year>
   </track>
   <track><artist>Deo</artist>
           <title>Exakt Neutral</title>
           <quote>tag für tag, nacht für nacht</quote>
           <year>1982</year>
   </track>
   <track><artist>André Szigethy</artist>
           <title>Liebe Banal</title>
           <quote>meine blicke glitzern</quote>
           <year>1983</year>
   </track>
   <track><artist>New Production Goes To Munich</artist>
           <title>Tippen Ein</title>
           <quote>da fängt doch niemand nichts mit an</quote>
           <year>1987</year>
   </track>
   <track><artist>Rendez-Vous</artist>
           <title>The Others</title>
           <quote>no more reason to believe</quote>
           <year>2014</year>
   </track>
   <track><artist>Minuit Machine</artist>
           <title>Empty Shell</title>
           <quote>when the end is near i forget who i am</quote>
           <year>2019</year>
   </track>
   <track><artist>Die Krupps</artist>
           <title>Robo Sapien (Mono Inc. Remix)</title>
           <quote>modified to outperform, acceleration the new norm</quote>
           <year>2014</year>
   </track>
   <track><artist>Spetsnaz</artist>
           <title>Apathy</title>
           <quote>what can we do then? nothing!</quote>
           <year>2004</year>
   </track>
   <track><artist>Carlo Onda</artist>
           <title>Schnee Fällt</title>
           <quote>du tanzt die geister weg</quote>
           <year>2020</year>
   </track>
   <track><artist>Susanne Blech</artist>
           <title>Die Maschinen Laufen Heiss</title>
           <quote>medizin hilft im besten fall, im schlimmsten fall nicht, die enttäuschung ist kleiner, wenn man statistiker ist</quote>
           <year>2012</year>
   </track>
   <track><artist>Raumheld</artist>
           <title>Konformisten</title>
           <quote>wenn du zu den nonkonformisten gehören willst, musst du dich anziehen wie wir und auf dieselbe musik stehen wie wir</quote>
           <year>2012</year>
   </track>
   <track><artist>Fraktus</artist>
           <title>Supergau</title>
           <quote>achtung achtung, der grösste anzunehmende ernstfall ist eingetroffen, gefühle verboten</quote>
           <year>2012</year>
   </track>
   </cd>  
