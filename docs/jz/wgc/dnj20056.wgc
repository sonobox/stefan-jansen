           <year>1983</year>
           <country>CH</country>
    </track>
    <track><artist>Lars Falk</artist>
           <title>Hello Hello</title>
           <quote>wherever i go i say</quote>
           <year>1983</year>
           <country>SE</country>
    </track>
    <track><artist>Fad Gadget</artist>
           <title>Ricky's Hand</title>
           <quote>six pints later it waved goodbye, picked his nose and squashed a fly</quote>
           <year>1980</year>
           <country>GB</country>
    </track>
    <track><artist>Cabaret Voltaire</artist>
           <title>Nag Nag Nag</title>
           <quote>so far so good, please recall if you could</quote>
           <year>1979</year>
           <country>GB</country>
    </track>
    <track><artist>UV Pop</artist>
           <title>Sleep Don't Talk</title>
