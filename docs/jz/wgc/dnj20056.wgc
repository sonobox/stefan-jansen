           <country>GB</country>
    </track>
    <track><artist>Deo</artist>
           <title>Exakt Neutral</title>
           <quote>kein mensch, kein tier</quote>
           <year>1982</year>
           <country>DE</country>
    </track>
    <track><artist>Grosse Freiheit</artist>
           <title>Ein Mann Zuviel</title>
