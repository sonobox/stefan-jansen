<wgcompilation>
  <title>Shagadelic Fembots</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2005.2</number>

  <content>
   <cd>
    <track><artist>Quincy Jones &amp; His Orchestra</artist>
           <title>Soul Bossa Nova</title>
           <quote font="italic">austin powers: as long as people are still having promiscuous sex with many anonymous partners without protection while at the same time experimenting with mind-expanding drugs in a consequence-free environment, i'll be sound as a pound</quote>
            <year>1962</year>
            <country>US</country>
    </track>
    <track><artist>Sergio Mendes &amp; Brasil '66</artist>
           <title>Mas Que Nada</title>
           <quote>Você não vai querer que eu chegue no final</quote>
           <year>1966</year>
           <country>BR</country>
   </track>
    <track><artist>Perez Prado</artist>
           <title>Mambo No.5</title>
           <quote font="italic">dr. evil: you know, i have one simple request and that is to have sharks with frickin' laser beams attached to their heads</quote>
            <year>1949</year>
            <country>CU</country>
    </track>
    <track><artist>Brigitte Bardot</artist>
           <title>Tu Veux Ou Tu Veux Pas</title>
           <quote>c'est comme la musique: y a du mauvais et du bon</quote>
            <year>1970</year>
            <country>FR</country>
    </track>
    <track><artist>Dusty Springfield</artist>
           <title>Haunted</title>
           <quote>life is nowhere and it's no fair</quote>
            <year>1971</year>
            <country>GB</country>
    </track>
    <track><artist>Bob Crewe &amp; Charles Fox</artist>
           <title>Barbarella</title>
           <quote>bring your dearness near till the dawn comes tumbling down</quote>
            <year>1968</year>
            <country>US</country>
    </track>
    <track><artist>The Chordettes</artist>
           <title>Mr. Sandman (Bring Me A Dream)</title>
           <quote>give him a lonely heart like pagliacci and lots of wavy hair like liberace</quote>
            <year>1957</year>
            <country>US</country>
    </track>
    <track><artist>Mike Flowers Pops</artist>
           <title>Please Release Me</title>
           <quote>to waste my life would be a sin</quote>
            <year>1996</year>
            <country>GB</country>
    </track>
    <track><artist>Andy Williams</artist>
           <title>Wives And Lovers</title>
           <quote>wives should always be lovers too</quote>
            <year>1963</year>
            <country>US</country>
    </track>
    <track><artist>Pink Martini</artist>
           <title>Let's Never Stop Falling In Love</title>
           <quote>i know a falling star can't fall forever</quote>
            <year>2004</year>
            <country>US</country>
    </track>
    <track><artist>Nouvelle Vague</artist>
           <title>In A Manner Of Speaking</title>
           <quote>i just want to say that just like you i should find a way to tell you everything by saying nothing</quote>
            <year>2004</year>
            <country>FR</country>
    </track>
    <track><artist>Feist</artist>
           <title>Mushaboom</title>
           <quote>it may be years until the day my dreams will match up with my pay</quote>
            <year>2003</year>
            <country>CA</country>
    </track>
    <track><artist>Françoise Hardy &amp; Malcolm McLaren</artist>
           <title>Revenge Of The Flowers</title>
           <quote>vous ne m'aurez jamais donné que le baiser du condamné</quote>
            <year>1994</year>
            <country>FR</country>
    </track>
    <track><artist>Marc Almond</artist>
           <title>A Lover Spurned</title>
           <quote>she'll tell her friends to treat you rough, that you just weren't good enough, make the going really tough for the pleasure of watching you burn in hell</quote>
            <year>1990</year>
            <country>GB</country>
    </track>
    <track><artist>Xander &amp; Anya</artist>
           <title>I'll Never Tell</title>
           <quote>my claim to fame was to maim and to mangle</quote>
           <year>2002</year>
           <country>US</country>
    </track>
    <track><artist>The Cardigans</artist>
           <title>Carnival</title>
           <quote>i will never know cause you will never show</quote>
           <year>1995</year>
           <country>SE</country>
    </track>
    <track><artist>Frank Popp Ensemble</artist>
           <title>Breakaway (Radio Edit)</title>
           <quote>before i fade away</quote>
           <year>2001</year>
           <country>DE</country>
    </track>
    <track><artist>Pizzicato 5</artist>
           <title>Twiggy, Twiggy</title>
           <quote>twiggy no mini skirt de, twiggy mitai na pose de</quote>
           <year>1995</year>
           <country>JP</country>
    </track>
    <track><artist>The Beatles</artist>
           <title>Please Mr. Postman</title>
           <quote>you didn't stop to make me feel better by leaving me a card or a letter</quote>
           <year>1963</year>
           <country>GB</country>
    </track>
    <track><artist>Cake</artist>
           <title>Perhaps, Perhaps, Perhaps</title>
           <quote>so if you really love me say yes, but if you don't dear: confess</quote>
           <year>1996</year>
           <country>US</country>
    </track>
    <track><artist>Sam The Sham &amp; The Pharaohs</artist>
           <title>Li'l Red Riding Hood</title>
           <quote>i'm gonna keep my sheep suit on</quote>
           <year>1966</year>
           <country>US</country>
    </track>
    <track><artist>The Turtles</artist>
           <title>You Showed Me</title>
           <quote>you taught it to me too, exactly what you do</quote>
           <year>1968</year>
           <country>US</country>
    </track>
    <track><artist>The Divine Comedy</artist>
           <title>Make It Easy On Yourself (Live)</title>
           <quote>oh, elvis, it's so hard to do</quote>
           <year>1997</year>
           <country>GB</country>
    </track>
    <track><artist>The Hollies</artist>
           <title>He Ain't Heavy...  He's My Brother</title>
           <quote>it's a long, long road from which there is no return</quote>
           <year>1969</year>
           <country>GB</country>
    </track>
   </cd>  
  </content>

