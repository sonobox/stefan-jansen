<wgcompilation>
  <title>Eigentlich Sollten Wir Erwachsen Werden</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2019.2</number>
  <content>
    <cd name = "Rock">
      <track><artist>Kante</artist>
             <title>Die Summe Der Einzelnen Teile</title>
             <quote>wir sind unterwegs, unterwegs zur musik, bis an die grenzen unserer physik</quote>
             <year>2000</year>
             <country>DE</country>
      </track>
      <track><artist>Die Sterne</artist>
             <title>Wahr Ist Was Wahr Ist</title>
             <quote>ich bin fest entschlossen, diesen Ort zu verlassen, die fesseln zu sprengen und fortan zu hassen, was ich hier geliebt hab und was mich, es tut mir leid inklusive dich</quote>
             <year>2002</year>
             <country>DE</country>
      </track>
      <track><artist>Darlo</artist>
             <title>Zehn Uhr Fünfzehn, Samstag Nacht</title>
             <quote>und der wasserhahn tropft topf tropf tropf</quote>
             <year>2005</year>
             <country>DE</country>
      </track>
      <track><artist>Farin Urlaub</artist>
             <title>Sumisu</title>
             <quote>manchmal auch the cure oder new order aber größtenteils die smiths</quote>
             <year>2001</year>
             <country>DE</country>
      </track>
      <track><artist>Olli Schulz &amp; Der Hund Marie</artist>
             <title>Unten Mit Dem King</title>
             <quote>die menschen sind wild und im casting-wahn und das allein ist grund genug um wegzufahren</quote>
             <year>2003</year>
             <country>DE</country>
      </track>
      <track><artist>Hund Am Strand</artist>
             <title>Jungen Mädchen</title>
             <quote>zieht eure t-shirts aus, yeah yeah</quote>
             <year>2005</year>
             <country>DE</country>
      </track>
      <track><artist>Tomte</artist>
             <title>Ich Sang Die Ganze Zeit Von Dir</title>
             <quote>auf einem platz in meinem herz steht dein name an der wand</quote>
             <year>2005</year>
             <country>DE</country>
      </track>
      <track><artist>Blumfeld</artist>
             <title>Diktatur Der Angepassten</title>
             <quote>das geld vibriert und auf den genchips diktiert ein freier markt das leben</quote>
             <year>2001</year>
             <country>DE</country>
      </track>
      <track><artist>Tocotronic</artist>
             <title>Hi Freaks (Time And Tide Mix)</title>
             <quote>unsere freundschaft ist das geld, mit dem wir bezahlen, was man zahlen muss</quote>
             <year>2002</year>
             <country>DE</country>
      </track>
      <track><artist>Anajo</artist>
             <title>Ich Hol Dich Hier Raus</title>
             <quote>ich kenne einen anwalt und der das gesetz</quote>
             <year>2004</year>
             <country>DE</country>
      </track>
      <track><artist>Virginia Jetzt!</artist>
             <title>Von Guten Eltern</title>
             <quote>lass niemanden mehr rein, nur die guten vielleicht, die erkennt man doch gleich</quote>
             <year>2003</year>
             <country>DE</country>
      </track>
      <track><artist>Sportfreunde Stiller</artist>
             <title>Ein Kompliment</title>
             <quote>die schaumkrone der woge der begeisterung</quote>
             <year>2002</year>
             <country>DE</country>
      </track>
      <track><artist>Wir Sind Helden</artist>
             <title>Guten Tag (Die Reklamation)</title>
             <quote>tausche blödes altes leben gegen neue version</quote>
             <year>2003</year>
             <country>DE</country>
      </track>
      <track><artist>MIA.</artist>
             <title>Kreisel</title>
             <quote>ich bin ein blitz, schlag alles kurz und klein</quote>
             <year>2002</year>
             <country>DE</country>
      </track>
      <track><artist>Winson</artist>
             <title>Wovon Lebt Eigentlich Peter?</title>
             <quote>schicke klamotten, mädchen im arm und schon geht er</quote>
             <year>2004</year>
             <country>DE</country>
      </track>
      <track><artist>Die Goldenen Zitronen</artist>
             <title>Flimmern</title>
             <quote>was sollen die nazis raus aus deutschland?</quote>
             <year>2001</year>
             <country>DE</country>
      </track>
      <track><artist>Madsen</artist>
             <title>Die Perfektion</title>
             <quote>nicht zu alt, nicht zu jung, nicht zu schlau, nicht zu dumm, völlig egal, exakt neutral, völlig banal, völlig egal</quote>
             <year>2005</year>
             <country>DE</country>
      </track>
      <track><artist>Der Junge Mit Der Gitarre</artist>
             <title>Hallo Worum Gehts Ich Bin Dagegen</title>
             <quote>gegen casting-agenturen, gegen schlager und die puren</quote>
             <year>2002</year>
             <country>DE</country>
      </track>
      <track><artist>Die Ärzte</artist>
             <title>Nichts In Der Welt</title>
             <quote>ich will so kalt sein, dass alle erfrieren</quote>
             <year>2003</year>
             <country>DE</country>
      </track>
      <track><artist>Element Of Crime</artist>
             <title>Delmenhorst</title>
             <quote>erst wenn alles scheißegal ist macht das leben wieder spaß</quote>
             <year>2005</year>
             <country>DE</country>
      </track>
      <track><artist>Kettcar</artist>
             <title>Landungsbrücken Raus</title>
             <quote>einsehen zum schluss, dass man weitermachen muss</quote>
             <year>2003</year>
             <country>DE</country>
      </track>
      <track><artist>Bernd Begemann</artist>
             <title>Judith, Mach Deinen Abschluss (Live)</title>
             <quote>huh, aktien geil</quote>
             <year>2001</year>
             <country>DE</country>
      </track>
    </cd>
    <cd name = "Pop">
      <track><artist>2raumwohnung</artist>
             <title>Wir Trafen Uns In Einem Garten</title>
             <quote>komm doch mal vorbei mit kuchen, später gehen wir in den zoo</quote>
             <year>2000</year>
             <country>DE</country>
      </track>
      <track><artist>Klee</artist>
             <title>Nicht Immer Aber Jetzt</title>
             <quote>ich seh das ziel</quote>
             <year>2003</year>
             <country>DE</country>
      </track>
      <track><artist>Juli</artist>
             <title>Perfekte Welle</title>
             <quote>denk am besten gar nicht nach</quote>
             <year>2004</year>
             <country>DE</country>
      </track>
      <track><artist>Die Moulinettes</artist>
             <title>Immer Nie Am Meer</title>
             <quote>und dann sitzt er stundenlang unter dem fön und es weht der wind durch seine haare</quote>
             <year>2001</year>
             <country>DE</country>
      </track>
      <track><artist>Andreas Dorau</artist>
             <title>Wir Sind Keine Freunde</title>
             <quote>jeder weiß, du hast gelogen und die wahrheit meist verbogen</quote>
             <year>2005</year>
             <country>DE</country>
      </track>
      <track><artist>Lee Buddah</artist>
             <title>Andy</title>
             <quote>die weissen tauben sind möwen und als ratten der lüfte bekannt</quote>
             <year>2005</year>
             <country>DE</country>
      </track>
      <track><artist>Jens Friebe</artist>
             <title>Gespenster (Baxendale's Becoming More Like Astley Remix)</title>
             <quote>hochfahren und dann auf verbinden</quote>
             <year>2005</year>
             <country>DE</country>
      </track>
      <track><artist>Paula</artist>
             <title>Als Es Passierte (Radio Edit)</title>
             <quote>der nachmittag brachte eine antwort und die erlösung</quote>
             <year>2000</year>
             <country>DE</country>
      </track>
      <track><artist>Superpunk</artist>
             <title>Man Kann Einen Ehrlichen Mann Nicht Auf Seine Knie Zwingen</title>
             <quote>mir wurde übel mitgespielt doch ich bin immer noch da</quote>
             <year>2001</year>
             <country>DE</country>
      </track>
      <track><artist>Fettes Brot</artist>
             <title>Ich Bin Müde</title>
             <quote>ich bin verkrampft, du bist so frei, du kommst 14:30 und ich um halb drei</quote>
             <year>2003</year>
             <country>DE</country>
      </track>
      <track><artist>Stereo Total</artist>
             <title>Wir Tanzen Im 4-Eck</title>
             <quote>wir tanzen konzentriert</quote>
             <year>2001</year>
             <country>DE</country>
      </track>
      <track><artist>Spillsbury</artist>
             <title>Was wir Machen (Kid Alex Boys Noize Remix Radio Edit)</title>
             <quote>trinken, rauchen, feiern</quote>
             <year>2004</year>
             <country>DE</country>
      </track>
      <track><artist>Mediengruppe Telekommander</artist>
             <title>Bis Zum Erbrechen Schreien</title>
             <quote>ihr wollt den deepsten shit, doch daraus wird wohl nichts</quote>
             <year>2004</year>
             <country>DE</country>
      </track>
      <track><artist>Deichkind</artist>
             <title>Limit</title>
             <quote>p-o-w zum e zum r, nach vorne bis zum gehtnichtmehr</quote>
             <year>2002</year>
             <country>DE</country>
      </track>
      <track><artist>Jeans Team</artist>
             <title>Keine Melodien (MJ Lan Mix Radio Edit)</title>
             <quote>ich singe eins, zwei, drei, vier</quote>
             <year>2000</year>
             <country>DE</country>
      </track>
      <track><artist>Lexy &amp; K-Paul feat. Sven Regener</artist>
             <title>Oder Beides</title>
             <quote>morgen früh sind wir schön oder tot</quote>
             <year>2003</year>
             <country>DE</country>
      </track>
      <track><artist>Die Fantastischen Vier</artist>
             <title>Geboren</title>
             <quote>du wirst geboren, religion, sohn vom sohn vom sohn vom sohn</quote>
             <year>2004</year>
             <country>DE</country>
      </track>
      <track><artist>Clueso</artist>
             <title>Wart Mal</title>
             <quote>all die hektik all der stress geben uns noch lange nicht das recht</quote>
             <year>2004</year>
             <country>DE</country>
      </track>
      <track><artist>Jan Delay</artist>
             <title>Vergiftet</title>
             <quote>mad mag keine buffalos</quote>
             <year>2001</year>
             <country>DE</country>
      </track>
      <track><artist>Beginner</artist>
             <title>City Blues</title>
             <quote>denn bei euch im süden von der elbe, da ist das leben nicht dasselbe</quote>
             <year>2003</year>
             <country>DE</country>
      </track>
      <track><artist>PeterLicht</artist>
             <title>Lied Gegen Die Schwerkraft</title>
             <quote>die schwerkraft ist überbewertet, man braucht sie gar nicht, wie man ja wohl im weltraum sieht</quote>
             <year>2001</year>
             <country>DE</country>
      </track>
    </cd>    
      
  </content>

