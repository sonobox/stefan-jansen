             <year>1984</year>
             <country>GB</country>
      </track>
      
      <track><artist>Techniques Berlin</artist>
             <title>Secret Lies</title>
             <quote>secret lies you tell the rest of the world</quote>
             <year>1990</year>
             <country>CA</country>
      </track>
      
      <track><artist>Soft Cell</artist>
