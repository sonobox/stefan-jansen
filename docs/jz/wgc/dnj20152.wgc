             <year>1989</year>
             <country>DE</country>
      </track>

      <track><artist>Psyche</artist>
             <title>Unveiling The Secret</title>
             <quote>no great army, no soldier of fortune could get me through that day</quote>
             <year>1986</year>
             <country>CA</country>
      </track>
       
      <track><artist>Axodry</artist>
             <title>Surrender</title>
