<wgcompilation>
  <title>Ronny's Pop Show</title> 
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2022.1</number>
  <content>
    <cd>
      <track><artist>Piefke Und Pafke Und Die Jungs Aus Der Dunkelkammer</artist>
             <title>Auf In Die Galaxien...</title>
             <quote>seit mehr als vielen, vielen wochen gibt die erde kein thema mehr für einen nummer-eins-hit her</quote>
             <year>1983</year>
             <country>DE</country>
      </track>
      <track><artist>Foxy</artist>
             <title>Du Bist Fort</title>
             <quote>träum von gestern, vergiß mich nicht</quote>
             <year>1985</year>
             <country>DE</country>
      </track>
      <track><artist>Camilla Motor</artist>
             <title>Rosa Video</title>
             <quote>im rosa schlafanzug vor'm videogerät</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>R + S Band</artist>
             <title>Telespiel</title>
             <quote>laserkrieg bei mir zuhaus</quote>
             <year>1984</year>
             <country>DE</country>
      </track>
      <track><artist>Der Plan</artist>
             <title>Gummitwist</title>
             <quote>gib mir parallelschnittstellen, 64-bit-prozessor, fortran, logo, cpu und visicalc und ram-modul</quote>
             <year>1983</year>
             <country>DE</country>
      </track>
      <track><artist>Ideal</artist>
             <title>Keine Heimat</title>
             <quote>wer schützt mich vor amerika?</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Potpourri</artist>
             <title>Ich Bin Durchsichtig</title>
             <quote>schwarzfahren ist lebensgefährlich, sibirien ist kalt</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Dauerpauer</artist>
             <title>Glatter Nullbon</title>
             <quote>monoton im stahlbeton, nach liebe schreit die welt</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Heinrich Und Die Heizer</artist>
             <title>Fatima</title>
             <quote>wir legen uns dort an den strand, das meer von uns, und wir auf land</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Clinch</artist>
             <title>Hallo Vater</title>
             <quote>aus mir ist nix geworden, mir geht's saugut</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Silberstreif</artist>
             <title>Bei Dir Ist Noch Licht</title>
             <quote>fühlst du meine nähe, doch sehen kannst du mich nicht</quote>
             <year>1983</year>
             <country>DE</country>
      </track>
      <track><artist>Nullzeit</artist>
             <title>Dein Ganzes Leben</title>
             <quote>kalt wie mondlicht strahlt das letzte feuer aus dir</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>4712</artist>
             <title>Steig Den Luis Trenker</title>
             <quote>und jetzt den toni seiler</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Weltschmertz</artist>
             <title>Grundunordnung</title>
             <quote>ich trinke, was ich will, das ist kein benzin</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Der Wilde Jürgen</artist>
             <title>Bleifuß Bis Barcelona</title>
             <quote>berge bleicher bäuche brutzeln bis bräune brennt</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Säurekeller</artist>
             <title>Hiroshima</title>
             <quote>dresden war so primitiv, bei uns ist jetzt alles radioaktiv</quote>
             <year>1985</year>
             <country>DE</country>
      </track>
      <track><artist>Stahlnetz</artist>
             <title>Der Falsche Kuß</title>
             <quote>liebling geh weg</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Christof Glowalla</artist>
             <title>Science Fiction</title>
             <quote>pressen sie die zunge fest gegen den gaumen</quote>
             <year>1981</year>
             <country>DE</country>
      </track>
      <track><artist>Klaus Prünster</artist>
             <title>Teleflipper Glückspielritter</title>
             <quote>ich lebe in einer automatenwelt</quote>
             <year>1982</year>
             <country>AT</country>
      </track>
      <track><artist>Christian Kneisel</artist>
             <title>Nähe Und Distanz</title>
             <quote>einigkeit und kampf</quote>
             <year>1983</year>
             <country>DE</country>
      </track>
      <track><artist>Prima Orchestra</artist>
             <title>Tanzen, Tanzen, Tanzen</title>
             <quote>bis morgens früh um acht</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Hoffmann's Stärke</artist>
             <title>Schöner Fremder Mann</title>
             <quote>doch am tag gehst du mit einer frau vorbei</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Luxus</artist>
             <title>Ich Steh Drauf</title>
             <quote>die leute sagen ich hätt 'nen spleen</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Nils Selzer</artist>
             <title>Freispiel</title>
             <quote>schießen, schießen, schießen ist alles, was mir bleibt</quote>
             <year>1981</year>
             <country>DE</country>
      </track>
   </cd>  
  </content>

