             <country>AT</country>
      </track>
      <track><artist>Kleenex Aktiv</artist>
             <title>Arsch Abschiessen (Live)</title>
             <quote>gestern um dieselbe zeit, heute um dieselbe zeit, morgen um dieselbe zeit steht die polizei bereit</quote>
             <year>1982</year>
             <country>AT</country>
      </track>
      <track><artist>Mordbuben AG</artist>
             <title>Bleib Blöd!</title>
             <quote>trotzdem ist dein dasein stumpf und öd'</quote>
             <year>1979</year>
             <country>AT</country>
      </track>
      <track><artist>Schund</artist>
             <title>Chaos</title>
             <quote>das leben ist zum kotzen, es hat keinen sinn, es gibt keine zukunft und kein glück</quote>
             <year>1982</year>
             <country>AT</country>
      </track>
      <track><artist>A-Gen 53</artist>
             <title>Stalingrad/Stumpfsinn</title>
             <quote>die jungen leut', beklagt's euch net, ihr habt's den krieg ja net erlebt</quote>
