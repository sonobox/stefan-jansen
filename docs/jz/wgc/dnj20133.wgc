             <year>1982</year>
             <country>AT</country>
      </track>
      <track><artist>Fallout</artist>
             <title>Jungs Über Der Stadt</title>
             <quote>sie sind einzelgänger und deshalb immer zu dritt, zu viert, zu fünft</quote>
