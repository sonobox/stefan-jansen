             <country>AT</country>
      </track>
      <track><artist>Die Vergifteten Pfeile</artist>
             <title>Es Geht Mir Gut</title>
             <quote>ich suche was mich glücklich macht, eure träume habe ich ausgelacht</quote>
             <year>1982</year>
             <country>AT</country>
      </track>
      <track><artist>Standart Oil</artist>
             <title>Spy</title>
