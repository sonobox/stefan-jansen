<wgcompilation>
  <title>Wien Du Tote Stadt</title> 
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2013.3</number>
  <content>
    <cd name = "U4">
      <track><artist>Sprays</artist>
             <title>Lieber Chaos</title>
             <quote>mörder in der stadt</quote>
             <year>1981</year>
             <country>AT</country>
      </track>
      <track><artist>Der Wilde Pinguin</artist>
             <title>Killer Der Nacht</title>
