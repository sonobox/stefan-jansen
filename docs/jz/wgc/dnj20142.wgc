             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Schwarze Bewegung</artist>
             <title>Traumfrau</title>
             <quote>und deine böse mutter spricht: du kriegst sie nicht!</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Michael Cretu</artist>
             <title>Total Normal</title>
