<wgcompilation>

  <title>Lambada, Lolita, Latino</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2002.3</number>

  <content>
   <cd>
    <track><artist>Badesalz</artist>
