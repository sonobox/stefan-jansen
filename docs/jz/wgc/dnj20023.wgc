           <country>FR</country>    
    </track>
    <track><artist>Jennifer Lopez</artist>
           <title>Ain't It Funny</title>
           <quote>life can be cruel in a way i can't explain</quote>
           <year>2001</year>
           <country>US</country>    
    </track>
    <track><artist>Shakira</artist>
