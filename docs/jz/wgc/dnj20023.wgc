           <country>FR</country>    
    </track>
    <track><artist>Britney Spears</artist>
           <title>...Baby One More Time</title>
           <quote>i must confess that my loneliness is killing me</quote>
           <year>1998</year>
           <country>US</country>    
    </track>
    <track><artist>Kylie Minogue</artist>
           <title>Can't Get You Out Of My Head</title>
