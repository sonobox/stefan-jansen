           <country>ES</country>    
    </track>
    <track><artist>Marc Anthony</artist>
           <title>I Need To Know</title>
           <quote>it's getting harder not to think of you</quote>
           <year>1999</year>
           <country>US</country>    
    </track>
    <track><artist>Maná</artist>
           <title>En El Muelle De San Blas</title>
           <quote>sola, sola, en el olvido - sola, sola con su espíritu</quote>
