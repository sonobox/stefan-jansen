<wgcompilation>
  <title>Tanzexplosion!</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2006.4</number>

  <content>
    <cd name = "DJ Fred &amp; Tina">
      <track><artist>Puff Daddy feat. Jimmy Page</artist>
             <title>Come With Me</title>
             <quote>i'm destructive, some women find that seductive</quote>
             <year>1998</year>
             <country>US</country>    
      </track>
      <track><artist>The Chemical Brothers</artist>
             <title>Block Rockin' Beats</title>
             <quote>we're about to rock steady</quote>
             <year>1997</year>
             <country>GB</country>    
      </track>
      <track><artist>The Prodigy</artist>
             <title>Breathe</title>
             <quote>psychosomatic addict insane</quote>
             <year>1997</year>
             <country>GB</country>    
      </track>
      <track><artist>Tori Amos</artist>
             <title>Professional Widow (Armand's Star Trunk Funkin' Mix)</title>
             <quote>everywhere a judas as far as you can see</quote>
             <year>1996</year>
             <country>US</country>    
      </track>
      <track><artist>Daft Punk</artist>
             <title>Rollin' &amp; Scratchin'</title>
             <quote>dr. schuh: dann sind sie wohl nicht verheiratet.</quote>
             <year>1996</year>
             <country>FR</country>    
      </track>
      <track><artist>Apoptygma Berzerk</artist>
             <title>Mourn</title>
             <quote>now i am you, do you want to be me?</quote>
             <year>1996</year>
             <country>NO</country>    
      </track>
      <track><artist>Second Decay</artist>
             <title>Hinter Glas</title>
             <quote>es scheint mir infernal</quote>
             <year>1994</year>
             <country>DE</country>    
      </track>
      <track><artist>Covenant</artist>
             <title>Stalker (Club Version)</title>
             <quote>i keep the wisdom that you need</quote>
             <year>1996</year>
             <country>SE</country>    
      </track>
      <track><artist>And One</artist>
             <title>Für</title>
             <quote>für die garde der letzten zweifler marschbefehl zum morgigen tag</quote>
             <year>1994</year>
             <country>DE</country>    
      </track>
      <track><artist>Psyche</artist>
             <title>Good-Bye Horses</title>
             <quote>oh no sir, i must say you're wrong</quote>
             <year>1996</year>
             <country>CA</country>    
      </track>
      <track><artist>Witt &amp; Heppner</artist>
             <title>Die Flut (Radio Edit)</title>
             <quote>und du siehst zum himmel auf, fluchst auf den sturen zeitenlauf</quote>
             <year>1998</year>
             <country>DE</country>    
      </track>
      <track><artist>Die Krupps</artist>
             <title>To The Hilt</title>
             <quote>burn the bridges, forge ahead</quote>
             <year>1993</year>
             <country>DE</country>    
      </track>
      <track><artist>OOMPH!</artist>
             <title>Gekreuzigt</title>
             <quote>du hast die welt verändert mit deinem herz aus gold</quote>
             <year>1998</year>
             <country>DE</country>    
      </track>
      <track><artist>Hunting Lodge</artist>
             <title>Tribal Warning Shot (Studio Version)</title>
             <quote>shapeless, undefined, driven</quote>
             <year>1984</year>
             <country>US</country>    
      </track>
      <track><artist>Die Ärzte</artist>
             <title>Männer Sind Schweine</title>
             <quote>diese schrecklichen haarigen biester</quote>
             <year>1998</year>
             <country>DE</country>    
      </track>
    </cd>    

    <cd name = "DJ MAD.e &amp; Z">
      <track><artist>Fatboy Slim</artist>
             <title>The Rockafeller Skank (Short Edit)</title>
             <quote>right about now, the funk soul brother</quote>
             <year>1998</year>
             <country>GB</country>    
     </track>
      <track><artist>CJ Bolland</artist>
             <title>Sugar Is Sweeter</title>
             <quote>come on and sugar me</quote>
             <year>1996</year>
             <country>BE</country>    
      </track>
      <track><artist>DMX Krew</artist>
             <title>Come To Me</title>
             <quote>dance with me, we'll be ok</quote>
             <year>1998</year>
             <country>GB</country>    
      </track>
      <track><artist>Jimi Tenor</artist>
             <title>Take Me Baby (Original Mix)</title>
             <quote>love me on our way to a dark star</quote>
             <year>1995</year>
             <country>FI</country>    
      </track>
      <track><artist>Mesh</artist>
             <title>You Didn't Want Me (Radio Mix)</title>
             <quote>i wish i'd never used this precious time on you</quote>
             <year>1997</year>
             <country>GB</country>    
      </track>
      <track><artist>Fusspils 11</artist>
             <title>Griechischer Wein (Samos Edit)</title>
             <quote>in dieser stadt werde ich immer nur ein fremder sein und allein</quote>
             <year>1998</year>
             <country>DE</country>    
      </track>
      <track><artist>Cleen</artist>
             <title>Did You Forget (Demo)</title>
             <quote>no way back</quote>
             <year>1997</year>
             <country>DE</country>    
      </track>
      <track><artist>Controlled Fusion</artist>
             <title>You</title>
             <quote>why don't you feel like me?</quote>
             <year>1998</year>
             <country>DE</country>    
      </track>
      <track><artist>Skinny Puppy</artist>
             <title>Inquisition (Single Mix)</title>
             <quote>torturer taints animal waits</quote>
             <year>1992</year>
             <country>CA</country>    
      </track>
      <track><artist>Front Line Assembly</artist>
             <title>Gun</title>
             <quote>frontline!</quote>
             <year>1992</year>
             <country>CA</country>    
      </track>
      <track><artist>KMFDM</artist>
             <title>Godlike</title>
             <quote>use the power, taste the bliss, harvest salvation</quote>
             <year>1990</year>
             <country>DE</country>    
      </track>
      <track><artist>Unit:187</artist>
             <title>Loaded</title>
             <quote>lust, lies, i'm alright</quote>
             <year>1997</year>
             <country>CA</country>    
      </track>
      <track><artist>Pointed feat. The Invincible Spirit</artist>
             <title>Push! (Joona Mix Radio Edit)</title>
             <quote>i tried to keep him on his knees</quote>
             <year>1998</year>
             <country>DE</country>    
      </track>
      <track><artist>Plastic Voice</artist>
             <title>Los Niños Del Parque (Long Version)</title>
             <quote>ciao gente: 1997 - un formidable anno</quote>
             <year>1997</year>
             <country>DE</country>    
      </track>
      <track><artist>Leila K.</artist>
             <title>Ça Plane Pour Moi (Short)</title>
             <quote>it's not today que le ciel me tombera sur la tête</quote>
             <year>1993</year>
             <country>SE</country>    
      </track>
      <track><artist>Jermaine Jackson &amp; Pia Zadora</artist>
             <title>When The Rain Begins To Fall</title>
             <quote>all my dreams of love began with the reality of you</quote>
             <year>1984</year>
             <country>US</country>    
      </track>
      <track><artist>Funny Van Dannen</artist>
             <title>Saufen</title>
             <quote>sie sagen für das glück ist es nie zu spät: es wartet zwischen wirklichkeit und realität</quote>
             <year>1996</year>
             <country>DE</country>    
      </track>
    </cd>
