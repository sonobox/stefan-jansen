<wgcompilation>
  <title>Dosenbier &amp; Chaostage</title> 
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2010.5</number>
  <content>
    <cd>
      <track><artist>Terrorgruppe</artist>
             <title>Der Rhein Ist Tot</title>
             <quote>aufgequoll'ne wasserleichen, hunderttausend teenies kreischen, mädchen flennen, schieben frust, die kellys treiben tot im fluss</quote>
             <year>1996</year>
             <country>DE</country>
      </track>
      <track><artist>Wizo</artist>
             <title>Klebstoff</title>
             <quote>dein hirn blockiert, dein herz steht still, du kannst es nicht fassen</quote>
             <year>1991</year>
             <country>DE</country>
      </track>
      <track><artist>Abstürzende Brieftauben</artist>
             <title>Kleine Mädchen</title>
             <quote>in der einen hand die kleine, denn sie hatte schöne beine, sie war'n schneller als mein blick mit meiner kohle warn sie weg</quote>
             <year>1987</year>
             <country>DE</country>
      </track>
      <track><artist>Die Ärzte</artist>
             <title>Madonnas Dickdarm</title>
             <quote>ich möchte yoko ono killen und ihr vermögen erben</quote>
             <year>1988</year>
             <country>DE</country>
      </track>
      <track><artist>Die Goldenen Zitronen</artist>
             <title>Des Teufels Wanderer</title>
             <quote>zieht sie ihres weges, bleiben scherben nur vom glück</quote>
             <year>1988</year>
             <country>DE</country>
      </track>
      <track><artist>King Rocko Schamoni</artist>
             <title>Der Tiger In Der Nacht</title>
             <quote>meine haare wehen im wind, auch wenn's keine echten sind</quote>
             <year>1988</year>
             <country>DE</country>
      </track>
      <track><artist>Die Roten Rosen</artist>
             <title>Popocatepetl-Twist</title>
             <quote>der für pepito wie tequila ist, so dass er alles auf der welt vergisst</quote>
             <year>1987</year>
             <country>DE</country>
      </track>
      <track><artist>Die Toten Hosen</artist>
             <title>Bis Zum Bitteren Ende</title>
             <quote>wir trinken immer noch ohne verstand</quote>
             <year>1983</year>
             <country>DE</country>
      </track>
      <track><artist>Normahl</artist>
             <title>Fraggles</title>
             <quote>arbeit ist 'ne qual, geld das ist mir scheissegal, ich steh' mehr auf frauen, die mich nich' verhauen</quote>
             <year>1985</year>
             <country>DE</country>
      </track>
      <track><artist>Punk Aid</artist>
             <title>Punkrock Party Feiern Wir Heut' Nacht</title>
             <quote>die moral von der geschicht': hitparaden mag ich nicht</quote>
             <year>1992</year>
             <country>DE</country>
      </track>
      <track><artist>Hannen Alks</artist>
             <title>Kölsche Jungs</title>
             <quote>rechts vom rhein beginnt das bayer-land</quote>
             <year>1994</year>
             <country>DE</country>
      </track>
      <track><artist>Geistige Verunreinigung</artist>
             <title>Moskau</title>
             <quote>wodka trinkt man pur und kalt, das macht 100 jahre alt</quote>
             <year>1994</year>
             <country>DE</country>
      </track>
      <track><artist>Die Frohlix</artist>
             <title>Faul Sein</title>
             <quote>wenn ich wiederkomm', will ich fleißig sein</quote>
             <year>1988</year>
             <country>DE</country>
      </track>
      <track><artist>Lustfinger</artist>
             <title>Bitte Lieber Staatsanwalt</title>
             <quote>ihre unschuld ist nur vorgetäuscht</quote>
             <year>1990</year>
             <country>DE</country>
      </track>
      <track><artist>Rotz Auf Der Wiese</artist>
             <title>Shirley</title>
             <quote>schon als sie klein war, war sie nicht sehr gross</quote>
             <year>2000</year>
             <country>DE</country>
      </track>
      <track><artist>Die Mimmi's</artist>
             <title>7 Jahre Doof</title>
             <quote>der fön fliegt schneller als mein hirn</quote>
             <year>1989</year>
             <country>DE</country>
      </track>
      <track><artist>Schliessmuskel</artist>
             <title>Gestrandet Auf Dem Mond</title>
             <quote>wir tranken astronautenwein und liebten unser monddasein</quote>
             <year>1991</year>
             <country>DE</country>
      </track>
      <track><artist>Walter Elf</artist>
             <title>Hertie Bei Nacht</title>
             <quote>ritter-sport und haribo</quote>
             <year>1988</year>
             <country>DE</country>
      </track>
      <track><artist>Marionetz</artist>
             <title>Ich Bin Ein T-Shirt</title>
             <quote>ich schlag die zeitung auf und schlag sie angewidert zu</quote>
             <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Trio</artist>
             <title>Ja Ja Wo Geht's Lang Peter Pank Schönen Dank</title>
             <quote>liegen bleiben, erst mal seh'n, wird schon geh'n</quote>
             <year>1981</year>
             <country>DE</country>
      </track>
      <track><artist>United Balls</artist>
             <title>Pogo in Togo</title>
             <quote>chaos in laos, drums in the slums</quote>
             <year>1981</year>
             <country>DE</country>
      </track>
      <track><artist>Male</artist>
             <title>Clever &amp; Smart</title>
             <quote>gott liebt irre</quote>
             <year>1979</year>
             <country>DE</country>
      </track>
      <track><artist>Die Skeptiker</artist>
             <title>Dada in Berlin</title>
             <quote>in der weimarer zeit roch es schon nach faschismus</quote>
             <year>1989</year>
             <country>DE</country>
      </track>
      <track><artist>Molotow Soda</artist>
             <title>Wasserleichen</title>
             <quote>die dinger sind, das sag ich Ihnen ehrlich, ein bisschen giftig und daher sehr gefährlich</quote>
             <year>1989</year>
             <country>DE</country>
      </track>
      <track><artist>Slime</artist>
             <title>Schweineherbst</title>
             <quote>frohsinn, dummheit, ausverkauf</quote>
             <year>1994</year>
             <country>DE</country>
      </track>
      <track><artist>Dritte Wahl</artist>
             <title>Auge Um Auge</title>
             <quote>der aufschwung geht jetzt los und zwar rasant</quote>
             <year>1994</year>
             <country>DE</country>
      </track>
      <track><artist>Toxoplasma</artist>
             <title>Asozial</title>
             <quote>keinen urlaub auf mallorca</quote>
             <year>1983</year>
             <country>DE</country>
      </track>
      <track><artist>Dimple Minds</artist>
             <title>Durstige Männer</title>
             <quote>mit schnaps und bier tun sie sich berauschen</quote>
             <year>1990</year>
             <country>DE</country>
      </track>
    </cd>    
  </content>

