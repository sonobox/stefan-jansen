<wgcompilation>
  <title>Où Va Le Monde?</title> 
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2018.1</number>
  <content>
    <cd>
      <track><artist>La Femme</artist>
             <title>Où Va Le Monde</title>
             <quote>oui, personne n'est fidèle, mais pourtant la vie doit rester toujours belle</quote>
             <year>2016</year>
             <country>FR</country>
      </track>
      <track><artist>Indochine</artist>
             <title>Station 13</title>
             <quote>tout mes héros sont morts</quote>
             <year>2017</year>
             <country>FR</country>
      </track>
      <track><artist>Sexy Sushi</artist>
             <title>Retour De Baton (Version Sereine)</title>
             <quote>et c'est toujours un peu dangereux de s'attacher à qui que ce soit</quote>
             <year>2013</year>
             <country>FR</country>
      </track>    
      <track><artist>Vive La Fête</artist>
             <title>Coucher Dans Mon Lit (World Audio Fidelity Remix)</title>
             <quote>elle danse dans le noir, les gars sont excités</quote>
             <year>2017</year>
             <country>BE</country>
      </track>
      <track><artist>Duel</artist>
             <title>Hey, Tu Ne Me Manqueras Plus</title>
             <quote>au bout de la nuit tout finit par brûler</quote>
             <year>2012</year>
             <country>FR</country>
      </track>
      <track><artist>Alizée</artist>
             <title>Toc De Mac</title>
             <quote>tu es mon maître à penser, mon maître à faire des galipettes</quote>
             <year>2003</year>
             <country>FR</country>
      </track>
      <track><artist>Luke</artist>
             <title>La Sentinelle</title>
             <quote>serait-ce la bête, serait-ce la bête, ou bien l'oppression?</quote>
             <year>2004</year>
             <country>FR</country>
      </track>
      <track><artist>Carrousel</artist>
             <title>Aussi Simple Que Ça</title>
             <quote>des idées noires et des pleurs à partager à côté des rats</quote>
             <year>2017</year>
             <country>CH</country>
      </track>
      <track><artist>Berry</artist>
             <title>Les Passagers</title>
             <quote>nous sommes des fugitifs, nos bonheurs sont furtifs</quote>
             <year>2012</year>
             <country>FR</country>
     </track>
     <track><artist>Black M</artist>
             <title>Sur Ma Route</title>
             <quote>je n'compte plus les soucis</quote>
             <year>2014</year>
             <country>FR</country>
      </track>
      <track><artist>Maître Gims</artist>
             <title>Est-ce Que Tu M'Aimes?</title>
             <quote>quand je t'ai mis la bague au doigt je me suis passé les bracelets</quote>
             <year>2015</year>
             <country>FR</country>
      </track>
      <track><artist>R. Wan</artist>
             <title>A Pic</title>
             <quote>je te prend, à bras le corps</quote>
             <year>2008</year>
             <country>FR</country>
      </track>
      <track><artist>Cali</artist>
             <title>Je M'En Vais</title>
             <quote>tu étais presque belle, j'étais pas loin d'être fidel</quote>
             <year>2005</year>
             <country>FR</country>
      </track>
      <track><artist>HK &amp; Les Saltimbanks</artist>
             <title>On Lâche Rien</title>
             <quote>c'est tellement con, tellement banal de parler d'paix, d'fraternité</quote>
             <year>2011</year>
             <country>FR</country>
     </track>
     <track><artist>Le Couleur</artist>
             <title>P.O.P</title>
             <quote>avec une clope, le vieux danseur est rêveur de l'époque pop</quote>
             <year>2016</year>
             <country>CA</country>
      </track>
      <track><artist>Lescop</artist>
             <title>La Forêt</title>
             <quote>personne n'a rien vu par chance, pour moi maintenant c'est fini</quote>
             <year>2011</year>
             <country>FR</country>
      </track>
      <track><artist>Mickey 3D</artist>
             <title>Respire</title>
             <quote>puis l'homme a débarqué avec ses gros souliers des coups de pieds dans la gueule pour se faire respecter</quote>
             <year>2002</year>
             <country>FR</country>
      </track>
      <track><artist>Thomas Fersen</artist>
             <title>Bambi</title>
             <quote>pas casser les jouets</quote>
             <year>2003</year>
             <country>FR</country>
      </track>
      <track><artist>Jérôme Minière avec Bia</artist>
             <title>Avril</title>
             <quote>rien n'est plus facile à briser que le fil qui nous relie</quote>
             <year>2010</year>
             <country>FR</country>
      </track>
      <track><artist>Yann Tiersen</artist>
             <title>Comptine D'Un Autre Été: L'Après Midi</title>
             <quote>trump: it was one of the greatest parades i've ever seen!</quote>
             <year>2001</year>
             <country>FR</country>
      </track>
   </cd>  
  </content>

