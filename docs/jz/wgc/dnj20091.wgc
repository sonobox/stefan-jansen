<wgcompilation>

  <title>La Movida</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2009.1</number>

  <content>
   <cd>
    <track><artist>Zombies</artist>
           <title>Groenlandia</title>
           <quote>el tiempo no puede esperar</quote>
           <year>1980</year>
           <country>ES</country>    
    </track>
    <track><artist>Radio Futura</artist>
           <title>Interferencias</title>
           <quote>en tu cabeza hay un error, en mis circuitos no entras tú, sólo algo nuevo es la razón para vivir</quote>
           <year>1980</year>
           <country>ES</country>    
    </track>
    <track><artist>Esqueletos</artist>
           <title>Radio 222</title>
           <quote>en dos minutos me explican que es amor</quote>
           <year>1983</year>
           <country>ES</country>    
    </track>
    <track><artist>P.V.P.</artist>
           <title>El Coche De La Plas</title>
           <quote>es ahí que tienes que gritar</quote>
           <year>1982</year>
           <country>ES</country>    
    </track>
    <track><artist>Glutamato Ye-Ye</artist>
           <title>Hay Un Hombre En Mi Nevera</title>
           <quote>cada mañana desaparece la mermelada</quote>
           <year>1982</year>
           <country>ES</country>    
    </track>
    <track><artist>Gabinete Caligari</artist>
           <title>Golpes</title>
           <quote>guardo las señales de tu amor hiriente, son mil cardenales de pasión</quote>
           <year>1982</year>
           <country>ES</country>    
    </track>
    <track><artist>Almodóvar &amp; McNamara</artist>
           <title>Gran Ganga</title>
           <quote>calamares por aquí, boquerones por allá</quote>
           <year>1982</year>
           <country>ES</country>    
    </track>
    <track><artist>Paralisis Permanente</artist>
           <title>Unidos</title>
           <quote>el cirujano no ha querido finalizar lo comenzado</quote>
           <year>1982</year>
           <country>ES</country>    
    </track>
    <track><artist>Alaska Y Los Pegamoides</artist>
           <title>Muy Cerca De Ti</title>
           <quote>conseguiré el paraiso con el que soñé</quote>
           <year>1979</year>
           <country>ES</country>    
    </track>
    <track><artist>Bomitoni Grup</artist>
           <title>Murciana</title>
           <quote>te quiero porque eres sucia, guarra, puta y lisonjera</quote>
           <year>1980</year>
           <country>ES</country>    
    </track>
    <track><artist>Kaka De Luxe</artist>
           <title>Rosario/Toca El Pito</title>
           <quote>olvido se ha escapado, se ha ido de su casa, ha matado a su padre con una lanza</quote>
           <year>1978</year>
           <country>ES</country>    
    </track>
    <track><artist>Siniestro Total</artist>
           <title>Ayatolah!</title>
           <quote>sólo vine a comprar pan y me enseñasteis el corán</quote>
           <year>1982</year>
           <country>ES</country>    
    </track>
    <track><artist>Los Nikis</artist>
           <title>Medicina Nuclear</title>
           <quote>tu mente desquiciada no te deja descansar, estas mal programado, tus circuitos van fatal</quote>
           <year>1981</year>
           <country>ES</country>    
    </track>
    <track><artist>Paraíso</artist>
           <title>Estrella De La Radio</title>
           <quote>gracias a la sintonía</quote>
           <year>1982</year>
           <country>ES</country>    
    </track>
    <track><artist>Alaska Y Dinarama</artist>
           <title>Perlas Ensangrentadas</title>
           <quote>aquella fue la última noche, tres tiros le hicieron callar</quote>
           <year>1983</year>
           <country>ES</country>    
    </track>
    <track><artist>Estación Victoria</artist>
           <title>Octubre Rojo</title>
           <quote>me siento morir cuando comisario pase junto a mi</quote>
           <year>1983</year>
           <country>ES</country>    
    </track>
    <track><artist>Derribos Arias</artist>
           <title>Branquias Bajo El Agua</title>
           <quote>inmersión en mi pecera</quote>
           <year>1982</year>
           <country>ES</country>    
    </track>
    <track><artist>Aviador Dro</artist>
           <title>Selector De Frecuencias</title>
           <quote>quizás hoy llegues donde yo no llegué: otros mundos, otras estrellas, para empezar otra vez desde mucho más alto</quote>
           <year>1982</year>
           <country>ES</country>    
    </track>
    <track><artist>Azul Y Negro</artist>
           <title>Me Estoy Volviendo Loco</title>
           <quote>poco a poco</quote>
           <year>1982</year>
           <country>ES</country>    
    </track>
    <track><artist>Luna</artist>
           <title>Mi Verdad</title>
           <quote>veo el mar en un estanque y en invierno siento calor</quote>
           <year>1983</year>
           <country>ES</country>    
    </track>
    <track><artist>La Mode</artist>
           <title>Enfermera De Noche</title>
           <quote>yo pago mis impuestos y también pago tus vicios y tus cosas</quote>
           <year>1982</year>
           <country>ES</country>    
    </track>
    <track><artist>Hombres G</artist>
           <title>Devuelveme A Mi Chica</title>
           <quote>ella se fué con un niño pijo en un ford fiesta blanco y un jersey amarillo</quote>
           <year>1985</year>
           <country>ES</country>    
    </track>
    <track><artist>Los Secretos</artist>
           <title>Ojos De Perdida</title>
           <quote>cuando me miras no sé cómo evitar esa mirada loca</quote>
           <year>1981</year>
           <country>ES</country>    
    </track>
    <track><artist>Nacha Pop</artist>
           <title>Chica De Ayer</title>
           <quote>las calles mojadas te han visto crecer y con tu corazón estás llorando otra vez</quote>
           <year>1980</year>
           <country>ES</country>    
    </track>
   </cd>  
