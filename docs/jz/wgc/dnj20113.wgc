             <country>DE</country>
      </track>
      <track><artist>Bernward Büker Bande</artist>
             <title>Eine Unter Millionen</title>
             <quote>sie hat so'n süßes t-shirt an und irgendwas ist an ihr dran</quote>
	           <year>1982</year>
             <country>DE</country>
      </track>
      <track><artist>Die Doraus Und Die Marinas</artist>
             <title>Fatme</title>
             <quote>trommeln dröhnen, flöten tönen und die wüstensöhne stöhnen</quote>
