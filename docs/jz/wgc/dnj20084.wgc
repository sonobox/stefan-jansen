<wgcompilation>
  <title>Do It The Italian Way</title>
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2008.4</number>

  <content>
   <cd name = "Dancing Madly">
    <track><artist>The Fashion</artist>
           <title>Future Girl</title>
           <quote>don't fly away</quote>
           <year>1984</year>
           <country>IT</country>    
    </track>
 
    <track><artist>The Flirts</artist>
           <title>Dancing Madly Backwards (Remix)</title>
           <quote>don't try to be a hero, that won't get you very far</quote>
           <year>1985</year>
           <country>US</country>    
    </track>

    <track><artist>Bobby Orlando</artist>
           <title>I Pretend</title>
           <quote>i am the love that's making me insane</quote>
           <year>1983</year>
           <country>US</country>    
    </track>

    <track><artist>K. Barré</artist>
           <title>Right By The Moon (Vocal)</title>
           <quote>there is a special place i like to be</quote>
           <year>1984</year>
           <country>IT</country>    
    </track>

    <track><artist>Albert One</artist>
           <title>For Your Love (Radio Version)</title>
           <quote>help me now 'cause there's no tomorrow</quote>
           <year>1986</year>
           <country>IT</country>    
    </track>

    <track><artist>Brand Image</artist>
           <title>Love In A Summer Night (Vocal)</title>
           <quote>you and me, sweet confusion</quote>
           <year>1985</year>
           <country>IT</country>    
    </track>

    <track><artist>Pet Shop Boys</artist>
           <title>Paninaro (Italian Remix)</title>
           <quote>my passion, my love, my sex, my money, violence, religion, injustice and death</quote>
           <year>1986</year>
           <country>GB</country>    
    </track>

  <track><artist>K.B. Caps</artist>
           <title>Do You Really Need Me (12&quot; Version)</title>
           <quote>i've got so much to share</quote>
           <year>1986</year>
           <country>DE</country>    
    </track>

    <track><artist>Den Harrow</artist>
           <title>Future Brain (12&quot; Version)</title>
           <quote>future brain you're getting stronger, it's a shame you'll never know how to find love</quote>
           <year>1985</year>
           <country>IT</country>    
    </track>

   <track><artist>Animotion</artist>
           <title>I Engineer (Dub Version)</title>
           <quote>i'll take the lead, you take the pain</quote>
           <year>1986</year>
           <country>US</country>    
    </track>

    <track><artist>Roni Griffith</artist>
           <title>Desire (Extended Version)</title>
           <quote>i want you by my side</quote>
           <year>1981</year>
           <country>US</country>    
    </track>

    <track><artist>Mike Mareen</artist>
           <title>Love Spy (Radio-Version)</title>
           <quote>call me when you're alone</quote>
           <year>1986</year>
           <country>DE</country>    
    </track>

    <track><artist>Murray Head</artist>
           <title>One Night In Bangkok (12&quot; Version)</title>
           <quote>the bars are temples but the pearls ain't free</quote>
           <year>1984</year>
           <country>GB</country>    
    </track>

    <track><artist>Baltimora</artist>
           <title>Tarzan Boy (7&quot; Version)</title>
           <quote>monkey business on a sunny afternoon</quote>
           <year>1984</year>
           <country>IT</country>    
    </track>
    </cd>  
    

   <cd name = "Crying Badly">

   <track><artist>Savage</artist>
           <title>Don't Cry Tonight (Original Version)</title>
           <quote>don't let me go</quote>
           <year>1983</year>
           <country>IT</country>    
    </track>

   <track><artist>Rose</artist>
           <title>Magic Carillon (Vocal)</title>
           <quote>carry on, where is my fantasy?</quote>
           <year>1984</year>
           <country>IT</country>    
    </track>

    <track><artist>Valerie Dore</artist>
           <title>The Night (Vocal Version)</title>
           <quote>so many things we have in common, why don't you stay with me tonight?</quote>
           <year>1984</year>
           <country>IT</country>    
    </track>

    <track><artist>Danny Keith</artist>
           <title>Keep On Music (Vocal)</title>
           <quote>so don't forget that never i will give you my soul</quote>
           <year>1984</year>
           <country>IT</country>    
    </track>

   <track><artist>Fantasy Life</artist>
           <title>Over And Over (12&quot; Version)</title>
           <quote>out of the darkness into the light and out the light into darkness again</quote>
           <year>1985</year>
           <country>IT</country>    
    </track>
   
    <track><artist>RAF</artist>
           <title>Self Control</title>
           <quote>so i make myself believin' that this night will never go</quote>
           <year>1984</year>
           <country>IT</country>    
    </track>
   
    <track><artist>Roxanne</artist>
           <title>Boys In Black Cars (Dance-Remix) (Vocal)</title>
           <quote>you make me a queen in your limousine</quote>
           <year>1987</year>
           <country>AT</country>    
    </track>

    <track><artist>Ryan Paris</artist>
           <title>Dolce Vita (Vocal)</title>
           <quote>before we're thrown in darkness say you'll never leave me now
</quote>
           <year>1983</year>
           <country>IT</country>    
    </track>

    <track><artist>Raggio Di Luna</artist>
           <title>Comanchero (Vocal)</title>
           <quote>day after day he is riding in the sun</quote>
           <year>1984</year>
           <country>IT</country>    
    </track>

   <track><artist>Paul McDouglas</artist>
           <title>Turbo-Geil</title>
           <quote>when you walk in the disco and you're looking for girls, then watch out for turbo</quote>
           <year>1986</year>
           <country>DE</country>    
    </track>

    <track><artist>Tone Band</artist>
           <title>Germany Calling (Extended Version)</title>
           <quote>all over the world</quote>
           <year>1981</year>
           <country>GB</country>    
    </track>

    <track><artist>Scotch</artist>
           <title>Take Me Up</title>
           <quote>come with me and sing forever</quote>
           <year>1985</year>
           <country>IT</country>    
    </track>

    <track><artist>Gazebo</artist>
           <title>I Like Chopin (12&quot; Version)</title>
           <quote>rainy days never say good-bye</quote>
           <year>1983</year>
           <country>IT</country>    
    </track>
   </cd>  

  </content>

