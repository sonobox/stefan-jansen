<wgcompilation>
  <title>La Edad De Oro</title> 
  <season>Jansen / Zeileis - Das Nächste Jahrtausend</season>
  <number>2021.3</number>
  <content>
    <cd>
      <track><artist>Loquillo Y Trogloditas</artist>
             <title>El Ritmo Del Garaje</title>
             <quote>tu madre no lo dice pero me mira mal: ¿quién es el chico tan raro con el que vas?</quote>
             <year>1983</year>
             <country>ES</country>
      </track>
      <track><artist>Glutamato Ye-Ye</artist>
             <title>Corazón Loco</title>
             <quote>tengo un corazón loco que arma un ruido infernal, si te acercas un poco</quote>
             <year>1982</year>
             <country>ES</country>
      </track>
      <track><artist>Los Nikis</artist>
             <title>Ernesto</title>
             <quote>te abrirá la cabeza con un tiesto</quote>
             <year>1981</year>
             <country>ES</country>
      </track>
      <track><artist>Tequila</artist>
             <title>Salta!!</title>
             <quote>las chicas de la esquina rien con picardía, yo sé que es lo que quieren y se lo voy a dar</quote>
             <year>1981</year>
             <country>ES</country>
      </track>
      <track><artist>Radio Futura</artist>
             <title>Enamorado De La Moda Juvenil</title>
             <quote>en un momento comprendí que el futuro ya está aquí</quote>
             <year>1980</year>
             <country>ES</country>
      </track>
      <track><artist>Orquesta Mondragón</artist>
             <title>Caperucita Feroz</title>
             <quote>yo lo que quiero es tu cuerpo tan brutal y lo que adoro es tu fuerza de animal</quote>
             <year>1980</year>
             <country>ES</country>
      </track>
      <track><artist>Paralisis Permanente</artist>
             <title>Autosuficiencia</title>
             <quote>me miro en el espejo y soy feliz y no pienso nunca en nadie mas que en mí</quote>
             <year>1982</year>
             <country>ES</country>
      </track>
      <track><artist>Ilegales</artist>
             <title>¡Hola Mamoncete!</title>
             <quote>el guarda en su bolsillo todo lo que vas a buscar</quote>
             <year>1983</year>
             <country>ES</country>
      </track>
      <track><artist>Pistones</artist>
             <title>El Pistolero</title>
             <quote>y yo sé que esta vez sin duda viene a por mí</quote>
             <year>1983</year>
             <country>ES</country>
      </track>
      <track><artist>Alaska Y Dinarama</artist>
             <title>Como Pudiste Hacerme Esto A Mi</title>
             <quote>yo que te hubiese querido hasta el fin</quote>
             <year>1984</year>
             <country>ES</country>
      </track>
      <track><artist>Casal</artist>
             <title>Embrujada</title>
             <quote>esta es mi bruja con tacón de aguja</quote>
             <year>1982</year>
             <country>ES</country>
      </track>
      <track><artist>Aviador Dro</artist>
             <title>La Zona Fantasma</title>
             <quote>no te atrevas a ir a solas internarte en la zona fantasma</quote>
             <year>1986</year>
             <country>ES</country>
      </track>
      <track><artist>Vocoder</artist>
             <title>Amor De Robot</title>
             <quote>solo piensa que una humana yo soy, quiera decirle tanto lo que lo siento que también yo soy un robot</quote>
             <year>1985</year>
             <country>ES</country>
      </track>
      <track><artist>Luna</artist>
             <title>Es Un Sueño</title>
             <quote>buscaremos otra civilización</quote>
             <year>1983</year>
             <country>ES</country>
      </track>
      <track><artist>Azul Y Negro</artist>
             <title>No Tengo Tiempo (Con Los Dedos De Una Mano)</title>
             <quote>no tengo tiempo para pensar, no tengo tiempo de programar, no tengo tiempo para escapar, no tengo tiempo de terminar</quote>
             <year>1983</year>
             <country>ES</country>
      </track>
      <track><artist>Metal Y Ca</artist>
             <title>Oriente</title>
             <quote>es tu destino</quote>
             <year>1984</year>
             <country>ES</country>
      </track>
      <track><artist>Los Inhumanos</artist>
             <title>Lady Di</title>
             <quote>mi amor es para ti</quote>
             <year>1983</year>
             <country>ES</country>
      </track>
      <track><artist>Hombres G</artist>
             <title>Marta Tiene Un Marcapasos</title>
             <quote>marta tiene un pasajero en su corazón</quote>
             <year>1986</year>
             <country>ES</country>
      </track>
      <track><artist>Farmacia De Guardia</artist>
             <title>Ella Es Demoledora</title>
             <quote>hay algo en su forma de andar por las calles de la puta ciudad</quote>
             <year>1985</year>
             <country>ES</country>
      </track>
      <track><artist>Armas Blancas</artist>
             <title>He Vuelto A Soñar Contigo</title>
             <quote>he olvidado de todo al despertar</quote>
             <year>1984</year>
             <country>ES</country>
      </track>
      <track><artist>Golpes Bajos</artist>
             <title>Malos Tiempos Para La Lírica</title>
             <quote>el azul del mar inunda mis ojos</quote>
             <year>1983</year>
             <country>ES</country>
      </track>
      <track><artist>La Dama Se Esconde</artist>
             <title>Amenazas</title>
             <quote>son tus palabras puñales, que abrirán algo muy dentro de mí</quote>
             <year>1986</year>
             <country>ES</country>
      </track>
      <track><artist>Minuit Polonia</artist>
             <title>Ibiza Underground</title>
             <quote>alguien triste, alguien triste muy triste, al fondo del local</quote>
             <year>1983</year>
             <country>ES</country>
      </track>
   </cd>  
